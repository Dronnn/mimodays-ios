    "To capture moments, allow camera access in iOS Settings." : {
      "comment" : "C13a body: camera access off",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لالتقاط اللحظات، يمكنك السماح بالوصول إلى الكاميرا من إعدادات iOS."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каб здымаць моманты, дазволь доступ да камеры ў Наладах iOS."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube in den iOS-Einstellungen den Kamerazugriff, um Momente festzuhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To capture moments, allow camera access in iOS Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para capturar momentos, permite el acceso a la cámara en Ajustes de iOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour capturer des moments, autorise l’accès à l’appareil photo dans Réglages iOS."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדי לתפוס רגעים, לאפשר גישה למצלמה בהגדרות iOS."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Պահեր նկարելու համար թույլատրիր տեսախցիկի մուտքը iOS-ի կարգավորումներում։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per catturare momenti, consenti l'accesso alla fotocamera in Impostazioni di iOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モーメントを撮影するには、iOSの「設定」でカメラへのアクセスを許可してください。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "მომენტების გადასაღებად iOS-ის პარამეტრებში კამერაზე წვდომა დაუშვი."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сәттерді түсіру үшін iOS параметрлерінде камераға рұқсат бер."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "순간을 담으려면 iOS 설정에서 카메라 접근을 허용하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geef in de iOS-instellingen toegang tot de camera om momenten vast te leggen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby łapać chwile, zezwól na dostęp do aparatu w Ustawieniach iOS."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para capturar momentos, permita o acesso à câmera nos Ajustes do iOS."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы снимать моменты, разреши доступ к камере в Настройках iOS."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillåt kameraåtkomst i iOS-inställningar för att fånga ögonblick."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An yakalamak için iOS Ayarları'nda kamera erişimine izin ver."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб знімати моменти, дозволь доступ до камери в Параметрах iOS."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要捕捉瞬间，请在 iOS 设置中允许访问相机。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要記錄瞬間，請在 iOS「設定」中允許取用相機。"
          }
        }
      }
    },
    "To record voice notes, allow microphone access in iOS Settings. You can still write a note." : {
      "comment" : "Microphone off screen: message under the title",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لتسجيل الملاحظات الصوتية، يمكنك السماح بالوصول إلى الميكروفون من إعدادات iOS. ولا يزال بإمكانك كتابة ملاحظة."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каб запісваць галасавыя нататкі, дазволь доступ да мікрафона ў Наладах iOS. Напісаць нататку можна і без гэтага."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube in den iOS-Einstellungen den Mikrofonzugriff, um Sprachnotizen aufzunehmen. Eine Notiz schreiben kannst du trotzdem."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To record voice notes, allow microphone access in iOS Settings. You can still write a note."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para grabar notas de voz, permite el acceso al micrófono en Ajustes de iOS. Aún puedes escribir una nota."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour enregistrer des notes vocales, autorise l’accès au micro dans Réglages iOS. Tu peux toujours écrire une note."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדי להקליט הערות קוליות, לאפשר גישה למיקרופון בהגדרות iOS. עדיין אפשר לכתוב הערה."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ձայնային գրառումներ անելու համար թույլատրիր խոսափողի մուտքը iOS-ի կարգավորումներում։ Գրավոր գրառում դեռ կարող ես անել։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per registrare note vocali, consenti l'accesso al microfono in Impostazioni di iOS. Puoi comunque scrivere una nota."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声メモを録音するには、iOSの「設定」でマイクへのアクセスを許可してください。文字のメモは書けます。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ხმოვანი ჩანაწერების ჩასაწერად iOS-ის პარამეტრებში მიკროფონზე წვდომა დაუშვი. ჩანიშვნის დაწერა მაინც შეგიძლია."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дауыстық жазбалар жазып алу үшін iOS параметрлерінде микрофонға рұқсат бер. Мәтіндік жазбаны бәрібір жаза аласың."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음성 메모를 녹음하려면 iOS 설정에서 마이크 접근을 허용하세요. 메모는 계속 쓸 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geef in de iOS-instellingen toegang tot de microfoon om spraaknotities op te nemen. Een notitie schrijven kan nog steeds."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby nagrywać notatki głosowe, zezwól na dostęp do mikrofonu w Ustawieniach iOS. Nadal możesz napisać notatkę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para gravar notas de voz, permita o acesso ao microfone nos Ajustes do iOS. Você ainda pode escrever uma nota."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы записывать голосовые заметки, разреши доступ к микрофону в Настройках iOS. Написать заметку можно и без этого."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillåt mikrofonåtkomst i iOS-inställningar för att spela in röstanteckningar. Du kan fortfarande skriva en anteckning."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesli not kaydetmek için iOS Ayarları'nda mikrofon erişimine izin ver. Yine de not yazabilirsin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб записувати голосові нотатки, дозволь доступ до мікрофона в Параметрах iOS. Написати нотатку можна й так."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要录制语音备注，请在 iOS 设置中允许访问麦克风。仍然可以写文字备注。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要錄製語音筆記，請在 iOS「設定」中允許取用麥克風。仍然可以寫下文字筆記。"
          }
        }
      }
    },
    "To speak over your movie, allow microphone access in iOS Settings. You can still add music." : {
      "comment" : "Microphone off screen from the movie editor's Record voice: message under the title",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "للتحدث فوق فيلمك، اسمح بالوصول إلى الميكروفون في إعدادات iOS. لا يزال بإمكانك إضافة موسيقى."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каб агучыць фільм, дазволь доступ да мікрафона ў Наладах iOS. Дадаць музыку можна і без гэтага."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube in den iOS-Einstellungen den Mikrofonzugriff, um über deinen Film zu sprechen. Musik hinzufügen kannst du trotzdem."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To speak over your movie, allow microphone access in iOS Settings. You can still add music."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para hablar sobre tu película, permite el acceso al micrófono en Ajustes de iOS. Aun así puedes añadir música."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour parler sur ton film, autorise l’accès au micro dans les Réglages iOS. Tu peux quand même ajouter de la musique."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדי לדבר על הסרט, אפשר גישה למיקרופון בהגדרות iOS. עדיין אפשר להוסיף מוזיקה."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ֆիլմիդ վրա խոսելու համար թույլատրիր խոսափողի հասանելիությունը iOS-ի Կարգավորումներում։ Երաժշտություն ավելացնել կարող ես նաև առանց դրա։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per parlare sopra il tuo film, consenti l’accesso al microfono in Impostazioni di iOS. Puoi comunque aggiungere musica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ムービーに声を重ねるには、iOSの「設定」でマイクへのアクセスを許可してください。音楽は追加できます。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ფილმის გასახმოვანებლად iOS-ის პარამეტრებში მიკროფონზე წვდომა დაუშვი. მუსიკის დამატება მაინც შეგიძლია."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фильміңе дауыс қосу үшін iOS Параметрлерінде микрофонға рұқсат бер. Музыка қоса беруге болады."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "영상 위에 목소리를 입히려면 iOS 설정에서 마이크 접근을 허용해 주세요. 음악은 그래도 추가할 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta in iOS-instellingen toegang tot de microfoon toe om over je film in te spreken. Muziek toevoegen kan nog steeds."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby nagrać głos do filmu, zezwól na dostęp do mikrofonu w Ustawieniach iOS. Muzykę możesz dodać i tak."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para falar por cima do seu filme, permita o acesso ao microfone nos Ajustes do iOS. Você ainda pode adicionar música."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы озвучить фильм, разреши доступ к микрофону в Настройках iOS. Добавить музыку можно и без этого."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillåt mikrofonåtkomst i iOS-inställningar för att prata över din film. Du kan fortfarande lägga till musik."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filminin üzerine konuşmak için iOS Ayarlar’da mikrofon erişimine izin ver. Yine de müzik ekleyebilirsin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб озвучити фільм, дозволь доступ до мікрофона в Параметрах iOS. Додати музику можна й так."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要为影片配音，请在 iOS 设置中允许访问麦克风。你仍然可以添加音乐。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要為影片配音，請在 iOS 設定中允許取用麥克風。你仍然可以加入音樂。"
          }
        }
      }
    },
