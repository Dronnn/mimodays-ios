      "comment": "Tab: moments on a map",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Map"
          }
        }
      }
    },
    "Memories": {
      "comment": "Tab: grid of all saved moments",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Memories"
          }
        }
      }
    },
    "Movies": {
      "comment": "Tab: movies made from moments",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Movies"
          }
        }
      }
    },
    "Not now": {
      "comment": "Closes a permission screen without asking",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not now"
          }
        }
      }
    },
    "One day, it becomes a movie.": {
      "comment": "OB-05 title",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One day, it becomes a movie."
          }
        }
      }
    },
    "Open Settings": {
      "comment": "Opens the app's page in iOS Settings",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings"
          }
        }
      }
    },
    "Page %lld of %lld": {
      "comment": "VoiceOver label of the onboarding progress dots, e.g. Page 2 of 6",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Page %1$lld of %2$lld"
          }
        }
      }
    },
    "Record without sound": {
      "comment": "C06c: skip the microphone and record silent videos",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record without sound"
          }
        }
      }
    },
    "Say a few words, write a note, or save the moment without a caption. Time is recorded automatically. Location is optional.": {
      "comment": "OB-04 body",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say a few words, write a note, or save the moment without a caption. Time is recorded automatically. Location is optional."
          }
        }
      }
    },
    "Set up reminders": {
      "comment": "OB-06 button; leads to reminder setup",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up reminders"
          }
        }
      }
    },
    "Settings": {
      "comment": "Gear button and Settings sheet title",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings"
          }
        }
      }
    },
    "Show what you see and how you look in the same photo or video. Your face appears in a small picture-in-picture frame. A single camera works, too.": {
      "comment": "OB-03 body",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show what you see and how you look in the same photo or video. Your face appears in a small picture-in-picture frame. A single camera works, too."
          }
        }
      }
    },
    "Skip": {
      "comment": "Skips the remaining onboarding pages",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skip"
          }
        }
      }
    },
    "Spring": {
      "comment": "Season label under a sample movie clip",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spring"
          }
        }
      }
    },
    "Summer": {
      "comment": "Season label under a sample movie clip",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Summer"
          }
        }
