          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu peux toutes les modifier dans Réglages iOS."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר לשנות כל אחת מהן בהגדרות iOS."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Դրանցից յուրաքանչյուրը կարող ես փոխել iOS-ի կարգավորումներում։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi cambiarle tutte in Impostazioni di iOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どの許可も、iOSの「設定」で変更できます。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ნებისმიერი მათგანის შეცვლა iOS-ის პარამეტრებში შეგიძლია."
