    "You can still change any of these for a single movie or export." : {
      "comment" : "Movies & export settings (S06): note under the export card",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك أيضًا تغيير أيٍّ من هذه الخيارات لفيلم أو عملية تصدير بعينها."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усё гэта можна змяніць для асобнага фільма або экспарту."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für einzelne Filme oder Exporte kannst du all das trotzdem ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can still change any of these for a single movie or export."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún puedes cambiar cualquiera de estos ajustes para una película o exportación concreta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu peux toujours modifier chacun de ces réglages pour un film ou un export précis."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עדיין אפשר לשנות כל אחת מהאפשרויות האלה עבור סרט או ייצוא מסוים."
          }
        },
        "hy" : {
          "stringUnit" : {
