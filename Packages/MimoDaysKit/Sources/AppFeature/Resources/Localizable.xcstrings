    "iOS's own screens, like permission requests, switch the next time MimoDays opens." : {
      "comment" : "Language settings: what follows a switch only after MimoDays opens again",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتغير شاشات iOS، مثل طلبات الأذونات، عند فتح MimoDays في المرة القادمة."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уласныя экраны iOS, напрыклад запыты дазволаў, пераключацца пры наступным адкрыцці MimoDays."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Bildschirme von iOS selbst, etwa Berechtigungsanfragen, wechseln beim nächsten Öffnen von MimoDays."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS's own screens, like permission requests, switch the next time MimoDays opens."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las pantallas propias de iOS, como las solicitudes de permiso, cambian la próxima vez que abras MimoDays."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les écrans propres à iOS, comme les demandes d’autorisation, changent à la prochaine ouverture de MimoDays."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מסכי iOS עצמם, כמו בקשות הרשאה, יתחלפו בפתיחה הבאה של MimoDays."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS-ի սեփական էկրանները, օրինակ՝ թույլտվության հարցումները, կփոխվեն MimoDays-ի հաջորդ բացման ժամանակ։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le schermate di iOS, come le richieste di autorizzazione, cambiano alla prossima apertura di MimoDays."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクセス許可の確認など、iOSの画面はMimoDaysを次に開いたときに切り替わります。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS-ის საკუთარი ეკრანები, მაგალითად ნებართვის მოთხოვნები, ენას MimoDays-ის შემდეგ გახსნისას შეცვლის."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рұқсат сұраулары сияқты iOS-тың өз экрандары MimoDays келесі рет ашылғанда ауысады."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "권한 요청과 같은 iOS 자체 화면은 다음에 MimoDays를 열 때 언어가 바뀌어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De eigen schermen van iOS, zoals toestemmingsverzoeken, wisselen de volgende keer dat MimoDays opent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekrany samego iOS, np. prośby o uprawnienia, zmienią się przy następnym otwarciu MimoDays."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As telas do próprio iOS, como pedidos de permissão, mudam na próxima vez que o MimoDays abrir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Экраны самой iOS, например запросы разрешений, переключатся при следующем открытии MimoDays."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS egna skärmar, som behörighetsförfrågningar, byter språk nästa gång MimoDays öppnas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İzin istekleri gibi iOS ekranları, MimoDays bir daha açıldığında değişir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Власні екрани iOS, як-от запити дозволів, перемкнуться наступного разу, коли MimoDays відкриється."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 自带的界面（例如权限请求）会在下次打开 MimoDays 时切换。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "權限要求等 iOS 系統畫面，會在下次開啟 MimoDays 時切換語言。"
          }
        }
      }
    },
