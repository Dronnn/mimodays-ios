    "Moments are deleted for good after 30 days. They are not shown anywhere else in the app." : {
      "comment" : "Recently deleted (M16) subtitle.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحذف اللحظات نهائيًا بعد 30 يومًا. ولا تظهر في أي مكان آخر في التطبيق."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Моманты выдаляюцца назаўсёды праз 30 дзён. Больш нідзе ў праграме яны не паказваюцца."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Momente werden nach 30 Tagen endgültig gelöscht. Sie erscheinen nirgendwo sonst in der App."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moments are deleted for good after 30 days. They are not shown anywhere else in the app."
          }
        },
