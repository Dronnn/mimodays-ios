          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Преврати месяц, поездку или целый год моментов в короткий фильм."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
