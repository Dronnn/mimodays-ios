    "The camera is busy with a call or another app. It comes back on its own." : {
      "comment" : "Camera note: a call or another app took the camera or microphone.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الكاميرا مشغولة بمكالمة أو تطبيق آخر. وستعود للعمل تلقائيًا."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Камера занятая званком або іншай праграмай. Яна вернецца сама."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kamera ist durch einen Anruf oder eine andere App belegt. Sie kommt von selbst zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The camera is busy with a call or another app. It comes back on its own."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cámara está ocupada por una llamada u otra app. Volverá por sí sola."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La caméra est occupée par un appel ou une autre app. Elle reviendra d’elle-même."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המצלמה בשימוש של שיחה או אפליקציה אחרת. היא תחזור לפעול בעצמה."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Տեսախցիկն օգտագործվում է զանգի կամ մեկ այլ հավելվածի կողմից։ Այն ինքնուրույն կվերականգնի աշխատանքը։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fotocamera è occupata da una chiamata o da un'altra app. Tornerà da sola."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通話か別のアプリがカメラを使用中です。自動で使えるようになります。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "კამერას ზარი ან სხვა აპი იყენებს. ის თავისით ჩაირთვება."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Камераны қоңырау немесе басқа қолданба пайдаланып жатыр. Ол өздігінен қайта қосылады."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "통화나 다른 앱에서 카메라를 사용 중이에요. 자동으로 다시 사용할 수 있게 돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De camera is bezet door een oproep of een andere app. Hij komt vanzelf terug."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aparat jest zajęty przez połączenie lub inną aplikację. Wróci sam."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A câmera está ocupada com uma ligação ou outro app. Ela volta sozinha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Камера занята звонком или другим приложением. Она вернется сама."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kameran används av ett samtal eller en annan app. Den kommer tillbaka av sig själv."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamera bir arama veya başka bir uygulama tarafından kullanılıyor. Kendiliğinden geri gelecek."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Камера зайнята дзвінком або іншим застосунком. Вона повернеться сама."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相机正被通话或其他 App 占用，稍后会自动恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相機正由通話或其他 App 使用，稍後會自行恢復。"
          }
        }
      }
    },
