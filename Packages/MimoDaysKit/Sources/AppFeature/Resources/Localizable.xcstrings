    "The microphone records only while you are recording a video or a voice note. You can say no: videos are still saved, just silent." : {
      "comment" : "C06c body: microphone explainer",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يسجّل الميكروفون إلا أثناء تسجيل فيديو أو ملاحظة صوتية. يمكنك الرفض؛ ستُحفظ الفيديوهات أيضًا، ولكن بلا صوت."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мікрафон запісвае толькі тады, калі ты запісваеш відэа або галасавую нататку. Можна адмовіцца: відэа ўсё роўна захоўваюцца, проста без гуку."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Mikrofon nimmt nur auf, während du ein Video oder eine Sprachnotiz aufnimmst. Du kannst ablehnen: Videos werden trotzdem gespeichert, nur ohne Ton."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The microphone records only while you are recording a video or a voice note. You can say no: videos are still saved, just silent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El micrófono solo graba mientras grabas un video o una nota de voz. Puedes decir que no: los videos se siguen guardando, solo que sin sonido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le micro n’enregistre que pendant que tu filmes une vidéo ou enregistres une note vocale. Tu peux refuser : les vidéos sont quand même enregistrées, simplement sans le son."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המיקרופון מקליט רק בזמן הקלטת סרטון או הערה קולית. אפשר לסרב: הסרטונים עדיין נשמרים, פשוט בלי קול."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Խոսափողը ձայնագրում է միայն, երբ տեսանյութ ես նկարում կամ ձայնային գրառում անում։ Կարող ես մերժել․ տեսանյութերը կպահպանվեն, պարզապես՝ առանց ձայնի։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il microfono registra solo mentre registri un video o una nota vocale. Puoi dire di no: i video vengono salvati lo stesso, solo senza audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マイクで録音するのは、ビデオや音声メモを録音しているときだけです。許可しなくてもビデオは保存できますが、無音になります。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "მიკროფონი მხოლოდ ვიდეოს ან ხმოვანი ჩანაწერის ჩაწერისას იწერს. შეგიძლია უარი თქვა: ვიდეოები მაინც შეინახება, უბრალოდ უხმოდ."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Микрофон тек бейне немесе дауыстық жазба жазып алғанда дыбыс жазады. Рұқсат бермесең де болады: бейнелер сақталады, тек дыбыссыз болады."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마이크는 동영상이나 음성 메모를 녹음할 때만 소리를 담아요. 허용하지 않아도 동영상은 소리 없이 저장돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De microfoon neemt alleen op terwijl je een video of spraaknotitie opneemt. Je kunt nee zeggen: video's worden dan nog steeds bewaard, alleen zonder geluid."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofon nagrywa tylko wtedy, gdy nagrywasz wideo lub notatkę głosową. Możesz odmówić: wideo nadal będzie zapisywane, ale bez dźwięku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O microfone só grava enquanto você grava um vídeo ou uma nota de voz. Você pode recusar: os vídeos continuam sendo salvos, só que sem som."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Микрофон пишет, только пока ты записываешь видео или голосовую заметку. Можно отказаться: видео все равно сохранятся, просто без звука."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofonen spelar bara in medan du spelar in en video eller en röstanteckning. Du kan säga nej: videor sparas ändå, bara utan ljud."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofon yalnızca video veya sesli not kaydederken kayıt yapar. Hayır diyebilirsin: videolar yine kaydedilir, sadece sessiz olur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мікрофон записує лише тоді, коли ти записуєш відео або голосову нотатку. Можна відмовитися: відео все одно збережуться, просто без звуку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "麦克风只在录制视频或语音备注时录音。也可以拒绝：视频照样会存储，只是没有声音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "麥克風只會在錄影或錄製語音筆記時收音。也可以不允許：影片仍會儲存，只是不會有聲音。"
          }
        }
      }
    },
    "The microphone records only while you are recording a voice note. Voice notes stay on your device." : {
      "comment" : "Explainer message before the system microphone prompt, from Voice note",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يسجّل الميكروفون إلا أثناء تسجيل ملاحظة صوتية. وتبقى الملاحظات الصوتية على جهازك."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мікрафон запісвае толькі тады, калі ты запісваеш галасавую нататку. Галасавыя нататкі застаюцца на тваёй прыладзе."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Mikrofon nimmt nur auf, während du eine Sprachnotiz aufnimmst. Sprachnotizen bleiben auf deinem Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The microphone records only while you are recording a voice note. Voice notes stay on your device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El micrófono solo graba mientras grabas una nota de voz. Las notas de voz no salen de tu dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le micro n’enregistre que pendant que tu enregistres une note vocale. Les notes vocales restent sur ton appareil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המיקרופון מקליט רק בזמן הקלטת הערה קולית. ההערות הקוליות נשארות במכשיר שלך."
