    "Waiting for approval. The tip goes through once it's approved." : {
      "comment" : "Donations (D01-D04): Ask to Buy: the purchase waits for a parent",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في انتظار الموافقة. تكتمل عملية الدعم بعد الموافقة عليها."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чакаем пацвярджэння. Пасля яго чаявыя будуць спісаны."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wartet auf Bestätigung. Das Trinkgeld geht durch, sobald es bestätigt ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waiting for approval. The tip goes through once it's approved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esperando aprobación. La propina se completará cuando se apruebe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En attente d’approbation. Le pourboire passera une fois approuvé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ממתין לאישור. הטיפ יעבור אחרי שיאושר."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Սպասում է հաստատման։ Հաստատվելուց հետո թեյավճարը կփոխանցվի։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In attesa di approvazione. La mancia verrà inviata una volta approvata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "承認待ちです。承認されると、チップの支払いが完了します。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "დამტკიცებას ელის. შემოწირულობის გადახდა დამტკიცების შემდეგ შესრულდება."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мақұлдау күтілуде. Демеу төлемі мақұлданғаннан кейін өтеді."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "승인 대기 중이에요. 승인되면 팁 결제가 완료돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wacht op goedkeuring. De fooi gaat door zodra hij is goedgekeurd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oczekiwanie na zgodę. Napiwek zostanie przekazany po jej otrzymaniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aguardando aprovação. A gorjeta será concluída assim que for aprovada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ждем одобрения. Чаевые пройдут, как только покупку одобрят."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Väntar på godkännande. Dricksen går igenom när den har godkänts."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onay bekleniyor. Onaylanınca bahşiş işlemi tamamlanacak."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чекаємо на схвалення. Чайові пройдуть, щойно покупку схвалять."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "等待批准。获得批准后即可完成打赏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在等待核准。核准後就會完成小費付款。"
          }
        }
      }
    },
    "We picked %lld of %lld, spread evenly across %@. Tap to add or remove." : {
      "comment" : "New movie (F05): intro. Picked count, all count, the period (e.g. October)",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اخترنا %1$lld من %2$lld، موزّعة بالتساوي على %3$@. يمكنك اللمس للإضافة أو الإزالة."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%3$@: мы выбралі %1$lld з %2$lld, раўнамерна размеркаваўшы іх па часе. Націсні, каб дадаць або прыбраць."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir haben %1$lld von %2$lld ausgewählt, gleichmäßig verteilt über %3$@. Tippe, um hinzuzufügen oder zu entfernen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We picked %1$lld of %2$lld, spread evenly across %3$@. Tap to add or remove."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elegimos %1$lld de %2$lld, repartidos por igual en %3$@. Toca para añadir o quitar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On en a choisi %1$lld sur %2$lld, répartis équitablement sur %3$@. Touche pour en ajouter ou en retirer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בחרנו %1$lld מתוך %2$lld, בפיזור אחיד על פני %3$@. להקיש כדי להוסיף או להסיר."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Հավասարաչափ ընտրել ենք %1$lld-ը %2$lld-ից (%3$@)։ Ավելացնելու կամ հեռացնելու համար հպիր։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne abbiamo scelti %1$lld su %2$lld, distribuiti in modo uniforme su %3$@. Tocca per aggiungere o rimuovere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%3$@全体から偏りなく、%2$lld個中%1$lld個を選びました。タップすると追加や取り除きができます。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ავარჩიეთ %1$lld მომენტი %2$lld-დან, თანაბრად განაწილებული: %3$@. დასამატებლად ან ამოსაღებად შეეხე."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%3$@ бойынша біркелкі бөліп, %2$lld сәттің %1$lld сәтін таңдадық. Қосу немесе алып тастау үшін түрт."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%3$@ 전체에 고르게 분포하도록 %2$lld개 중 %1$lld개를 골랐어요. 탭해서 추가하거나 제거하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We hebben er %1$lld van de %2$lld gekozen, gelijk verdeeld over %3$@. Tik om toe te voegen of weg te halen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybrano %1$lld z %2$lld, równomiernie z zakresu „%3$@”. Stuknij, aby dodać lub usunąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolhemos %1$lld de %2$lld, distribuídos igualmente em %3$@. Toque para adicionar ou remover."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мы выбрали %1$lld из %2$lld равномерно по всему периоду: %3$@. Нажимай, чтобы добавить или убрать."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi valde %1$lld av %2$lld, jämnt fördelade över %3$@. Tryck för att lägga till eller ta bort."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%3$@ boyunca eşit dağılacak şekilde %1$lld / %2$lld an seçtik. Eklemek veya çıkarmak için dokun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ми вибрали %1$lld з %2$lld, рівномірно охопивши %3$@. Торкнись, щоб додати чи прибрати."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从 %2$lld 个中选了 %1$lld 个，均匀分布于%3$@。轻点即可添加或移除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已從 %2$lld 個瞬間中選出 %1$lld 個，均勻涵蓋%3$@。點一下即可加入或移除。"
          }
        }
      }
    },
    "We take photos of birthdays and big adventures. But most of life happens on ordinary days. MimoDays helps you remember those, too." : {
      "comment" : "OB-01 body",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نلتقط صورًا لأعياد الميلاد والمغامرات الكبيرة. لكن معظم الحياة يمضي في أيام عادية. يساعدك MimoDays على تذكّرها أيضًا."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мы фатаграфуем дні нараджэння і вялікія прыгоды. Але большая частка жыцця праходзіць у звычайныя дні. MimoDays дапамагае запомніць і іх."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir fotografieren Geburtstage und große Abenteuer. Doch das meiste Leben passiert an ganz normalen Tagen. MimoDays hilft dir, auch die in Erinnerung zu behalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We take photos of birthdays and big adventures. But most of life happens on ordinary days. MimoDays helps you remember those, too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hacemos fotos de cumpleaños y grandes aventuras. Pero la mayor parte de la vida ocurre en días normales. MimoDays te ayuda a recordarlos también."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On photographie les anniversaires et les grandes aventures. Mais l’essentiel de la vie se passe les jours ordinaires. MimoDays t’aide à te souvenir de ceux-là aussi."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אנחנו מצלמים ימי הולדת והרפתקאות גדולות. אבל רוב החיים קורים בימים רגילים. MimoDays עוזרת לזכור גם אותם."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Մենք լուսանկարում ենք ծննդյան օրերն ու մեծ արկածները։ Բայց կյանքի մեծ մասն անցնում է սովորական օրերին։ MimoDays-ն օգնում է հիշել նաև դրանք։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotografiamo compleanni e grandi avventure. Ma gran parte della vita succede nei giorni normali. MimoDays ti aiuta a ricordare anche quelli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "誕生日や大冒険は写真に残します。でも、人生の大半は何気ない毎日です。MimoDaysは、そんな日々も思い出に残すお手伝いをします。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "დაბადების დღეებსა და დიდ თავგადასავლებს ვიღებთ. მაგრამ ცხოვრების დიდი ნაწილი ჩვეულებრივ დღეებში გადის. MimoDays მათ დამახსოვრებაშიც გეხმარება."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Біз туған күндер мен үлкен саяхаттарды фотоға түсіреміз. Ал өмірдің көбі қарапайым күндерде өтеді. MimoDays оларды да есте сақтауға көмектеседі."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "생일이나 큰 모험은 사진으로 남기죠. 하지만 삶의 대부분은 평범한 날에 흘러가요. MimoDays는 그런 날도 기억할 수 있게 도와줘요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We maken foto's van verjaardagen en grote avonturen. Maar het meeste van het leven gebeurt op gewone dagen. MimoDays helpt je ook die te onthouden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Robimy zdjęcia na urodzinach i podczas wielkich przygód. Ale większość życia to zwykłe dni. MimoDays pomaga zapamiętać także je."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gente tira fotos de aniversários e grandes aventuras. Mas a maior parte da vida acontece nos dias comuns. O MimoDays ajuda você a lembrar desses também."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мы фотографируем дни рождения и большие приключения. Но большая часть жизни проходит в обычные дни. MimoDays помогает запомнить и их."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi fotograferar födelsedagar och stora äventyr. Men det mesta av livet händer på vanliga dagar. MimoDays hjälper dig att minnas dem också."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doğum günlerinin ve büyük maceraların fotoğraflarını çekeriz. Ama hayatın çoğu sıradan günlerde yaşanır. MimoDays onları da hatırlamana yardımcı olur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ми фотографуємо дні народження й великі пригоди. Але більша частина життя минає у звичайні дні. MimoDays допомагає запам’ятати й їх."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们会为生日和大冒险拍照，但生活的大部分都发生在平凡的日子里。MimoDays 帮你把这些日子也记下来。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我們會拍下生日和精彩的冒險，但生活大多發生在平凡的日子裡。MimoDays 也幫忙留住這些日常。"
          }
        }
      }
    },
