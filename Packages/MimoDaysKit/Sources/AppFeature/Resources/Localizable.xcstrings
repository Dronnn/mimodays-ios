    "The photo moves to Recently deleted. You can bring it back within 30 days." : {
      "comment" : "Delete sheet (M15) body for a photo with no selfie window, note or voice note.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنتقل الصورة إلى «المحذوفة مؤخرًا». يمكنك استعادتها خلال 30 يومًا."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фота перамяшчаецца ў «Нядаўна выдаленыя». Яго можна вярнуць на працягу 30 дзён."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Foto kommt in „Zuletzt gelöscht“. Du kannst es innerhalb von 30 Tagen zurückholen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The photo moves to Recently deleted. You can bring it back within 30 days."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La foto pasa a Eliminado recientemente. Puedes recuperarla en un plazo de 30 días."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La photo va dans Suppressions récentes. Tu peux la récupérer pendant 30 jours."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התמונה תועבר ל״נמחקו לאחרונה״. אפשר לשחזר אותה תוך 30 יום."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Լուսանկարը տեղափոխվում է «Վերջերս ջնջված» բաժին։ Կարող ես այն վերականգնել 30 օրվա ընթացքում։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La foto va in Eliminati di recente. Puoi recuperarla entro 30 giorni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真は「最近削除した項目」に移動します。30日以内なら元に戻せます。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ფოტო გადავა „ახლახან წაშლილში“. 30 დღის განმავლობაში მისი დაბრუნება შეგიძლია."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фото «Жақында жойылғандар» бөліміне өтеді. Оны 30 күн ішінде қайтара аласың."
