    "That surprise has passed. Catch a moment anyway?" : {
      "comment" : "Surprise ribbon on Today (T04): today's surprise expired without a moment. Gentle, no guilt.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتهى وقت تلك المفاجأة. ما رأيك بالتقاط لحظة على أي حال؟"
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гэты сюрпрыз ужо мінуў. Можа, усё роўна зловіш момант?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Überraschung ist vorbei. Trotzdem einen Moment einfangen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That surprise has passed. Catch a moment anyway?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esa sorpresa ya pasó. ¿Capturas un momento de todos modos?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette surprise est passée. Saisir un moment quand même ?"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ההפתעה הזו חלפה. לתפוס רגע בכל זאת?"
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Այդ անակնկալն անցել է։ Միևնույն է, մի պահ որսա՞նք։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quella sorpresa è passata. Vuoi cogliere un momento lo stesso?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今回のサプライズは終わりました。今、モーメントを撮りませんか？"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ეს სიურპრიზი უკვე დასრულდა. მაინც დაიჭერ მომენტს?"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бұл тосын сыйдың уақыты өтті. Сонда да бір сәтті ұстап қаласың ба?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그 서프라이즈는 지나갔어요. 그래도 순간을 담아 볼까요?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die verrassing is voorbij. Toch een moment vangen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta niespodzianka już minęła. Złapiesz chwilę mimo to?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essa surpresa já passou. Capturar um momento mesmo assim?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот сюрприз уже прошел. Поймать момент все равно?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den överraskningen har passerat. Vill du fånga ett ögonblick ändå?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O sürprizin süresi doldu. Yine de bir an yakalayalım mı?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей сюрприз уже минув. Може, все одно зловиш момент?"
          }
