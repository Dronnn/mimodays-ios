        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今はお知らせなしで。大丈夫です。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ჯერ შეხსენებების გარეშე. არაუშავს."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Әзірге еске салғышсыз. Ештеңе етпейді."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금은 알림 없이 지내도 괜찮아요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voorlopig geen herinneringen. Dat is prima."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na razie bez przypomnień. To nic."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem lembretes por enquanto. Tudo bem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока без напоминаний. Это нормально."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inga påminnelser just nu. Det är helt okej."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şimdilik anımsatıcı yok. Sorun değil."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поки без нагадувань. І це нормально."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暂时不提醒，也没关系。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先不提醒，也沒關係。"
          }
        }
      }
    },
    "No surprises come while paused, and none are sent later for the time missed." : {
      "comment" : "Surprise settings (S02): message of the pause choices",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تصل مفاجآت أثناء الإيقاف المؤقت، ولا تُرسل لاحقًا لتعويض ما فات."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Падчас паўзы сюрпрызы не прыходзяць, і за прапушчаны час іх потым не дасылаюць."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Während der Pause kommen keine Überraschungen, und für die verpasste Zeit wird nichts nachgeschickt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No surprises come while paused, and none are sent later for the time missed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mientras están en pausa no llegan sorpresas, y después no se envían las del tiempo perdido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune surprise n’arrive pendant la pause, et aucune n’est envoyée plus tard pour rattraper le temps manqué."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בזמן ההשהיה לא מגיעות הפתעות, וגם לא נשלחות אחר כך הפתעות על הזמן שחלף."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Դադարի ընթացքում անակնկալներ չեն գալիս, իսկ բաց թողած ժամանակի համար հետո չեն ուղարկվում։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante la pausa non arrivano sorprese, e quelle perse non vengono inviate dopo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一時停止中はサプライズが届きません。その間の分が後から届くこともありません。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "პაუზის დროს სიურპრიზები არ მოდის და გამოტოვებულ დროზე მოგვიანებითაც არ იგზავნება."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кідірту кезінде тосын сыйлар келмейді. Өткізіп алған уақыт үшін олар кейін де жіберілмейді."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일시 정지 중에는 서프라이즈가 오지 않아요. 그동안 놓친 서프라이즈를 나중에 보내지도 않아요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tijdens een pauze komen er geen verrassingen, en ze worden achteraf ook niet ingehaald."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podczas pauzy nie przychodzą żadne niespodzianki i nie są potem nadrabiane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhuma surpresa chega durante a pausa, e nenhuma é enviada depois pelo tempo perdido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Во время паузы сюрпризы не приходят, и за пропущенное время их потом не присылают."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inga överraskningar kommer medan de är pausade, och inga skickas i efterhand för den missade tiden."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duraklatıldığında sürpriz gelmez. Kaçırılan sürenin sürprizleri daha sonra da gönderilmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Під час паузи сюрпризи не приходять, і за пропущений час їх не надішлють пізніше."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暂停期间不会有惊喜，之后也不会补发错过的惊喜。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暫停期間不會收到驚喜，錯過的也不會在之後補發。"
          }
        }
      }
    },
