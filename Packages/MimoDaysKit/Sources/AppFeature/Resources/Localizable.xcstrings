    "Pick how often and when. The exact time is always a surprise." : {
      "comment" : "Surprise schedule (onboarding O07): body under the headline",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك اختيار عدد المرات والأوقات. ويبقى الوقت المحدد مفاجأة دائمًا."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберы, як часта і калі. Дакладны час заўсёды застаецца сюрпрызам."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle, wie oft und wann. Die genaue Uhrzeit ist immer eine Überraschung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick how often and when. The exact time is always a surprise."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige con qué frecuencia y cuándo. La hora exacta siempre es una sorpresa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisis la fréquence et le moment de la journée. L’heure exacte reste toujours une surprise."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לבחור באיזו תדירות ומתי. השעה המדויקת היא תמיד הפתעה."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ընտրիր՝ որքան հաճախ և երբ։ Ճշգրիտ ժամը միշտ անակնկալ է։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli quanto spesso e quando. L'ora esatta è sempre una sorpresa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "頻度と時間帯を選びます。いつ届くかは、毎回のお楽しみです。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "აირჩიე, რამდენად ხშირად და როდის. ზუსტი დრო ყოველთვის სიურპრიზია."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Қаншалықты жиі және қашан келетінін таңда. Нақты уақыты әрдайым тосын болады."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빈도와 시간대를 정하세요. 정확히 언제일지는 늘 서프라이즈예요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies hoe vaak en wanneer. Het precieze tijdstip is altijd een verrassing."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz, jak często i kiedy. Dokładna pora to zawsze niespodzianka."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha com que frequência e quando. O horário exato é sempre uma surpresa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбери, как часто и когда. Точное время – всегда сюрприз."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj hur ofta och när. Den exakta tiden är alltid en överraskning."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sıklığı ve saatleri seç. Tam zamanı her zaman sürprizdir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вибери, як часто й коли. Точний час — завжди сюрприз."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
