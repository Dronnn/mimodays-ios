        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De microfoon neemt alleen op terwijl je een spraaknotitie opneemt. Spraaknotities blijven op je apparaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofon nagrywa tylko wtedy, gdy nagrywasz notatkę głosową. Notatki głosowe zostają na twoim urządzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
