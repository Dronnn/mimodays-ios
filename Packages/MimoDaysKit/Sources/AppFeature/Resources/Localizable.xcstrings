        "ka" : {
          "variations" : {
            "device" : {
              "ipad" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "დღეები და დრო მიჰყვება იმას, სადაც ეს iPad ახლაა, ამიტომ გვიან საღამოს გადაღებული ფოტო შეიძლება მომდევნო დღეზე გადავიდეს."
                }
