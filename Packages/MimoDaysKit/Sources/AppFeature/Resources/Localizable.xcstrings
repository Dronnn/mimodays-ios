    "Search looks at notes, voice-note words and places." : {
      "comment" : "Search (M09): what search reads.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يشمل البحث الملاحظات والكلمات في الملاحظات الصوتية والأماكن."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пошук праглядае нататкі, словы з галасавых нататак і месцы."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Suche durchsucht Notizen, Wörter aus Sprachnotizen und Orte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Search looks at notes, voice-note words and places."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La búsqueda mira en las notas, las palabras de las notas de voz y los lugares."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La recherche porte sur les notes, les mots des notes vocales et les lieux."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החיפוש בודק הערות, מילים מהערות קוליות ומקומות."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Որոնումն ընդգրկում է գրառումները, ձայնային գրառումների բառերը և վայրերը։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ricerca guarda le note, le parole delle note vocali e i luoghi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メモ、音声メモの言葉、場所を検索します。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ძიება ამოწმებს ჩანიშვნებს, ხმოვანი ჩანაწერების სიტყვებსა და ადგილებს."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Іздеу жазбаларды, дауыстық жазбадағы сөздерді және орындарды қарайды."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메모, 음성 메모의 말, 장소를 검색해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoeken kijkt naar notities, woorden in spraaknotities en plekken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyszukiwanie obejmuje notatki, słowa z notatek głosowych i miejsca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A busca considera notas, palavras das notas de voz e lugares."
