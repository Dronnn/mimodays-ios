    "Shown before the first clip. Drag it on the timeline to move it between clips." : {
      "comment" : "U51: footnote at the bottom of the text card sheet",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر قبل المقطع الأول. يمكنك سحبها على المخطط الزمني لنقلها بين المقاطع."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Паказваецца перад першым кліпам. Перацягні яе на шкале часу, каб перамясціць паміж кліпамі."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erscheint vor dem ersten Clip. Zieh die Tafel auf der Zeitleiste, um sie zwischen Clips zu verschieben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shown before the first clip. Drag it on the timeline to move it between clips."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se muestra antes del primer clip. Arrástrala en la línea de tiempo para moverla entre clips."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affichée avant le premier clip. Fais-la glisser sur la timeline pour la placer entre des clips."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מוצג לפני הקטע הראשון. לגרור אותו בציר הזמן כדי להזיז אותו בין קטעים."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ցուցադրվում է առաջին հատվածից առաջ։ Քաշիր այն ժամանակագծի վրա՝ հատվածների միջև տեղափոխելու համար։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appare prima della prima clip. Trascinalo sulla timeline per spostarlo tra le clip."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最初のクリップの前に表示されます。タイムライン上でドラッグすると、クリップの間に移動できます。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ჩანს პირველი კლიპის წინ. დროის ხაზზე გადაათრიე, რომ კლიპებს შორის გადაიტანო."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Алғашқы клиптің алдында көрсетіледі. Клиптердің арасына жылжыту үшін оны уақыт шкаласында сүйре."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "첫 클립 앞에 표시돼요. 타임라인에서 드래그하면 클립 사이로 옮길 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordt vóór de eerste clip getoond. Sleep hem op de tijdlijn om hem tussen clips te zetten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyświetlana przed pierwszym klipem. Przeciągnij ją na osi czasu, aby przenieść między klipy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aparece antes do primeiro clipe. Arraste-o na linha do tempo para movê-lo entre os clipes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывается перед первым клипом. Перетащи ее на шкале времени, чтобы поставить между клипами."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visas före första klippet. Dra det på tidslinjen för att flytta det mellan klipp."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İlk klipten önce gösterilir. Kliplerin arasına taşımak için zaman çizelgesinde sürükle."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показується перед першим кліпом. Перетягни її на шкалі часу, щоб перемістити між кліпами."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
