    "In silent mode, photos never make a sound." : {
      "comment" : "Camera settings (S03, ••• sheet): note under the Shutter sound toggle",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في النمط الصامت، لا يصدر التقاط الصور أي صوت."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У бязгучным рэжыме фота здымаюцца без гуку."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Stummmodus machen Fotos nie ein Geräusch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In silent mode, photos never make a sound."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En modo silencio, las fotos nunca hacen ruido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En mode silencieux, les photos ne font jamais de bruit."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "במצב שקט, צילום תמונות לעולם לא משמיע צליל."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Լուռ ռեժիմում լուսանկարելիս ձայն երբեք չի հնչում։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In modalità silenziosa, le foto non fanno mai rumore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "消音モードでは、写真の撮影音は鳴りません。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "უხმო რეჟიმში ფოტოები ხმას არასდროს გამოსცემს."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Үнсіз режимде фото түсіру ешқашан дыбыс шығармайды."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무음 모드에서는 사진을 찍을 때 소리가 나지 않아요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In de stille modus maken foto's nooit geluid."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W trybie cichym zdjęcia nigdy nie wydają dźwięku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No modo silencioso, as fotos nunca fazem som."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В бесшумном режиме фото снимаются без звука."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I ljudlöst läge låter bilder aldrig."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessiz modda fotoğraflar asla ses çıkarmaz."
          }
