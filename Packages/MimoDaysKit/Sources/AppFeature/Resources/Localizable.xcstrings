          }
        }
      }
    },
    "Pick moments and give them a place by hand. Nothing is looked up automatically." : {
      "comment" : "Without a place (P05b): intro under the title.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك اختيار لحظات وإضافة أماكنها يدويًا. لا يُبحث عن أي شيء تلقائيًا."
          }
        },
        "be" : {
          "stringUnit" : {
