    "Long-press and drag to move. Tap a dot between two to change how one leads into the next." : {
      "comment" : "U50: hint under the editor timeline",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بالضغط مطولًا والسحب، يمكنك تغيير الترتيب. وبلمس النقطة بين مقطعين، يمكنك تغيير الانتقال من أحدهما إلى الآخر."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каб перамясціць кліп, націсні і ўтрымлівай яго, затым перацягні. Націсні на кропку паміж двума кліпамі, каб змяніць пераход ад аднаго да наступнага."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte gedrückt und zieh, um zu verschieben. Tippe auf einen Punkt zwischen zwei Clips, um zu ändern, wie einer in den nächsten übergeht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Long-press and drag to move. Tap a dot between two to change how one leads into the next."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado y arrastra para mover. Toca un punto entre dos para cambiar cómo se pasa de uno al siguiente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintiens et fais glisser pour déplacer. Touche un point entre deux clips pour changer le passage de l’un à l’autre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ללחוץ לחיצה ארוכה ולגרור כדי להזיז. להקיש על נקודה בין שני קטעים כדי לשנות את המעבר מאחד לשני."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Սեղմիր ու պահիր, ապա քաշիր՝ տեղափոխելու համար։ Հպիր երկու հատվածների միջև եղած կետին՝ դրանց անցումը փոխելու համար։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto e trascina per spostare. Tocca un punto tra due clip per cambiare il passaggio dall'una all'altra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長押ししてドラッグすると移動できます。間の点をタップすると、次のクリップへのつながり方を変えられます。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "გადასატანად ხანგრძლივად შეეხე და გადაათრიე. ორ ნაწილს შორის წერტილს შეეხე, რომ მათ შორის გადასვლა შეცვალო."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жылжыту үшін басып ұстап, сүйре. Бір клиптен келесісіне ауысуды өзгерту үшін екеуінің арасындағы нүктені түрт."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "길게 누른 채 드래그하면 이동해요. 두 클립 사이의 점을 탭하면 다음 클립으로 이어지는 방식을 바꿀 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd ingedrukt en sleep om te verplaatsen. Tik op een stip tussen twee clips om te kiezen hoe de ene in de volgende overgaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przytrzymaj i przeciągnij, aby przesunąć. Stuknij kropkę między dwoma klipami, aby zmienić, jak jeden przechodzi w drugi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha pressionado e arraste para mover. Toque num ponto entre dois para mudar como um passa para o seguinte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажми и удерживай, чтобы перетащить. Нажми на точку между клипами, чтобы изменить переход от одного к другому."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck länge och dra för att flytta. Tryck på en punkt mellan två för att ändra hur det ena leder in i nästa."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taşımak için basılı tutup sürükle. Bir klipten diğerine geçişi değiştirmek için aralarındaki noktaya dokun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Утримуй і перетягуй, щоб перемістити. Торкнись крапки між двома кліпами, щоб змінити перехід від одного до іншого."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "长按并拖动即可移动。轻点两个片段之间的圆点，可更改前一个如何过渡到下一个。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住並拖移即可移動。點一下兩者之間的圓點，可調整前後的轉場方式。"
          }
        }
      }
    },
