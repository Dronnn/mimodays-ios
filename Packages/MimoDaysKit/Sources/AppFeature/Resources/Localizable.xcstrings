          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どの設定も、ムービーや書き出しごとに変更できます。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ნებისმიერი მათგანის შეცვლა ცალკეული ფილმისთვის ან ექსპორტისთვისაც შეგიძლია."
