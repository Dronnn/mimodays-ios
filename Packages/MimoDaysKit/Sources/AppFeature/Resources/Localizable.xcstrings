{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "A little moment is happening.": {
      "comment": "Surprise notification title (also shown in onboarding art)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A little moment is happening."
          }
        }
      }
    },
    "A little surprise": {
      "comment": "Ribbon on the camera when it was opened from a surprise notification",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A little surprise"
          }
        }
      }
    },
    "A little surprise, every day.": {
      "comment": "OB-02 title",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A little surprise, every day."
          }
        }
      }
    },
    "Add sound to your videos?": {
      "comment": "C06c title: explainer shown before the system microphone prompt",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add sound to your videos?"
          }
        }
      }
    },
    "At a random moment, MimoDays may invite you to capture what is happening right now. Busy? Skip it. There are no streaks, scores, or missed-day penalties.": {
      "comment": "OB-02 body",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At a random moment, MimoDays may invite you to capture what is happening right now. Busy? Skip it. There are no streaks, scores, or missed-day penalties."
          }
        }
      }
    },
    "Autumn": {
      "comment": "Season label under a sample movie clip",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Autumn"
          }
        }
      }
    },
    "Capture": {
      "comment": "Accessibility label of the big camera button on Today",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture"
          }
        }
      }
    },
    "Close": {
      "comment": "Closes the camera",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        }
      }
    },
    "Coffee, rain, and one stubborn bug.": {
      "comment": "Sample handwritten note in onboarding art",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coffee, rain, and one stubborn bug."
          }
        }
      }
    },
    "Continue": {
      "comment": "Primary button on a permission explainer; shows the system prompt next",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue"
          }
        }
      }
    },
    "Done": {
      "comment": "Closes the Settings sheet",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        }
      }
    },
    "Find your memories by date or place. Turn a month, a year, or any part of your life into a movie made from real, little moments.": {
      "comment": "OB-05 body",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find your memories by date or place. Turn a month, a year, or any part of your life into a movie made from real, little moments."
          }
        }
      }
    },
    "Give your moment a voice.": {
      "comment": "OB-04 title",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give your moment a voice."
          }
        }
      }
    },
    "Let MimoDays use the camera": {
      "comment": "C06 title: explainer shown before the system camera prompt",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let MimoDays use the camera"
          }
        }
      }
    },
    "Look around. This could be a memory.": {
      "comment": "Surprise notification body (also shown in onboarding art)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look around. This could be a memory."
          }
        }
      }
    },
