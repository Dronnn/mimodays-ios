    "Twice a day, between %@ and %@. You can change this any time in Settings." : {
      "comment" : "Onboarding O08b body. %1$@ = earliest time, %2$@ = latest time, e.g. 8:00 AM",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مرتين يوميًا، بين %1$@ و%2$@. يمكنك تغيير ذلك في أي وقت من الإعدادات."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Двойчы на дзень, з %1$@ да %2$@. Гэта можна змяніць у любы час у Наладах."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zweimal am Tag, zwischen %1$@ und %2$@. Du kannst das jederzeit in den Einstellungen ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twice a day, between %1$@ and %2$@. You can change this any time in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dos veces al día, entre las %1$@ y las %2$@. Puedes cambiarlo cuando quieras en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deux fois par jour, entre %1$@ et %2$@. Tu peux changer ça quand tu veux dans Réglages."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פעמיים ביום, בין %1$@ ל־%2$@. אפשר לשנות זאת בכל עת בהגדרות."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Օրը երկու անգամ՝ %1$@-ից %2$@-ի միջև։ Սա կարող ես ցանկացած ժամանակ փոխել Կարգավորումներում։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Due volte al giorno, tra le %1$@ e le %2$@. Puoi cambiarlo quando vuoi in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1日2回、%1$@から%2$@の間に届きます。「設定」でいつでも変更できます。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "დღეში ორჯერ, %1$@-სა და %2$@-ს შორის. ამის შეცვლა ნებისმიერ დროს შეგიძლია პარამეტრებში."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Күніне екі рет, %1$@ және %2$@ арасында. Мұны кез келген уақытта Параметрлерде өзгерте аласың."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하루 두 번, %1$@~%2$@ 사이에 와요. 설정에서 언제든 바꿀 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
