      "comment" : "Privacy statement (S05): what the app never does",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بلا إعلانات ولا تتبّع ولا تحليلات، ولا يُباع أو يُشارك أي شيء."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ні рэкламы, ні адсочвання, ні аналітыкі, і нічога не прадаецца і не перадаецца."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Werbung, kein Tracking, keine Analyse – und nichts wird verkauft oder weitergegeben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No ads, no tracking, no analytics, and nothing is sold or shared."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin anuncios, sin rastreo, sin analíticas, y nada se vende ni se comparte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas de pub, pas de pistage, pas d’analyses, et rien n’est vendu ni partagé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אין פרסומות, מעקב או ניתוח שימוש, ושום דבר לא נמכר או משותף."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ո՛չ գովազդ, ո՛չ հետևում, ո՛չ վերլուծություն։ Ոչինչ չի վաճառվում կամ փոխանցվում ուրիշներին։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niente pubblicità, tracciamento o statistiche, e nulla viene venduto o condiviso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "広告もトラッキングも解析もありません。データを販売したり共有したりすることもありません。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "არც რეკლამა, არც თვალთვალი, არც ანალიტიკა. არაფერი იყიდება ან ზიარდება."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жарнама, бақылау, аналитика жоқ. Ештеңе сатылмайды және ешкімге берілмейді."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "광고도 추적도 분석도 없고, 어떤 정보도 판매하거나 공유하지 않아요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen advertenties, geen tracking, geen analyses, en niets wordt verkocht of gedeeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez reklam, śledzenia i analityki. Nic nie jest sprzedawane ani udostępniane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem anúncios, sem rastreamento, sem análises, e nada é vendido nem compartilhado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Никакой рекламы, отслеживания и аналитики; ничего не продается и не передается."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen reklam, ingen spårning, ingen analys, och inget säljs eller delas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reklam, takip veya analiz yok. Hiçbir şey satılmaz ya da paylaşılmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жодної реклами, стеження чи аналітики, і нічого не продається й не передається."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
