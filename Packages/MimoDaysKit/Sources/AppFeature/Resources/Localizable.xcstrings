    "This moment is kept until you free up about %@. Nothing is lost." : {
      "comment" : "Alert message when there isn't enough space to save (C13c). %@ = space to free, e.g. 40 MB",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى هذه اللحظة محفوظة حتى تُخلي نحو %@. لم يُفقد شيء."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Момант пачакае, пакуль ты не вызваліш прыблізна %@. Нічога не страчана."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Moment bleibt erhalten, bis du etwa %@ freigibst. Nichts geht verloren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This moment is kept until you free up about %@. Nothing is lost."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este momento se conserva hasta que liberes unos %@. No se pierde nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce moment est conservé jusqu’à ce que tu libères environ %@. Rien n’est perdu."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הרגע הזה נשמר עד לפינוי של כ־%@. שום דבר לא אבד."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Այս պահը կպահվի, մինչև մոտ %@ տեղ ազատես։ Ոչինչ չի կորել։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo momento resta qui finché non liberi circa %@. Non si perde nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "約%@の空き容量を確保するまで、このモーメントは保持されます。失われたものはありません。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ეს მომენტი შენარჩუნდება, სანამ დაახლოებით %@-ს გაათავისუფლებ. არაფერი დაკარგულა."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шамамен %@ орын босатқанша, бұл сәт осында қалады. Ештеңе жоғалған жоқ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "약 %@의 공간을 확보할 때까지 이 순간은 보관돼요. 사라진 항목은 없어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit moment wordt vastgehouden tot je ongeveer %@ vrijmaakt. Er gaat niets verloren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta chwila poczeka, aż zwolnisz około %@. Nic nie przepadło."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este momento fica guardado até você liberar cerca de %@. Nada foi perdido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Момент подождет, пока ты освободишь примерно %@. Ничего не потеряно."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ögonblicket finns kvar tills du har frigjort cirka %@. Inget går förlorat."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu an, yaklaşık %@ yer açana kadar korunur. Hiçbir şey kaybolmadı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей момент чекатиме, доки ти не звільниш близько %@. Нічого не втрачено."
