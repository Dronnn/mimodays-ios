  "strings": {
    "%@ of %@": {
      "comment": "Voice note sheet (C09): accessibility value of the stop button, e.g. \"12 seconds of 1 minute\". First: time recorded, second: the limit",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ of %2$@"
          }
        }
      }
    },
    "%@ · Surprise": {
