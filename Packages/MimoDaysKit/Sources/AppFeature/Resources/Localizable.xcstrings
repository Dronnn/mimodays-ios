{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ move to Recently deleted. You can bring them back within 30 days." : {
      "comment" : "Delete sheet (M15) body for one moment with more than its photo or video. %@ is its parts as a list, e.g. \"The photo, selfie window and voice note\"",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ move to Recently deleted. You can bring them back within 30 days."
          }
        }
      }
    },
    "%@ – %@ · %@ s" : {
      "comment" : "Trim sheet: a video's chosen start and end and their length, as 0:02 – 0:05 · 3.0 s",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ – %2$@ · %3$@ s"
          }
        }
      }
    },
    "%@ · %@" : {
      "comment" : "New movie (F02): a period and how many moments it has, e.g. October 2026 · 38 moments",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@"
          }
        }
      }
    },
    "%@ · %@ · %@" : {
