    "Group moments that belong together, like a trip or someone's firsts." : {
      "comment" : "Collections: what collections are for, when there are none.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك جمع اللحظات المترابطة، مثل رحلة أو التجارب الأولى لشخص ما."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Збірай разам звязаныя моманты, напрыклад з вандроўкі або першыя падзеі ў чыімсьці жыцці."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fasse Momente zusammen, die zusammengehören – wie eine Reise oder die ersten Male von jemandem."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Group moments that belong together, like a trip or someone's firsts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrupa los momentos que van juntos, como un viaje o las primeras veces de alguien."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regroupe les moments qui vont ensemble, comme un voyage ou les premières fois de quelqu’un."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לקבץ רגעים ששייכים יחד, כמו טיול או הפעמים הראשונות של מישהו."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Խմբավորիր իրար կապված պահերը, օրինակ՝ ճամփորդությունը կամ ինչ-որ մեկի առաջին փորձառությունները։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raggruppa i momenti che vanno insieme, come un viaggio o le prime volte di qualcuno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旅や誰かの初めての体験など、つながりのあるモーメントをまとめられます。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "დააჯგუფე მომენტები, რომლებიც ერთმანეთს ეკუთვნის, მაგალითად მოგზაურობა ან ვინმეს პირველი გამოცდილებები."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сапар сәттері немесе біреудің өміріндегі алғашқы оқиғалар сияқты өзара байланысты сәттерді топта."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여행이나 누군가의 첫 경험처럼, 함께 간직하고 싶은 순간을 모아 보세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Groepeer momenten die bij elkaar horen, zoals een reis of iemands eerste keren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grupuj chwile, które do siebie pasują, jak podróż albo czyjeś pierwsze razy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrupe momentos que combinam, como uma viagem ou as primeiras vezes de alguém."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Объединяй моменты, которые связаны между собой, например поездку или чьи-то первые шаги."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gruppera ögonblick som hör ihop, som en resa eller någons första gånger."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir yolculuk veya birinin ilkleri gibi birbirine ait anları grupla."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Групуй моменти, що пасують одне до одного, як-от подорож чи чиїсь перші кроки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把相关的瞬间归到一起，比如一次旅行，或某个人的许多“第一次”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
