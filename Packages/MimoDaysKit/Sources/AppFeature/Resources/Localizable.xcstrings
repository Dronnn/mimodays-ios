        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "შეეხე გულს ნებისმიერ მომენტზე, რომ აქ შეინახო."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сәтті осында сақтау үшін ондағы жүрекшені түрт."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "순간의 하트를 탭하면 여기에 보관돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op het hartje bij een moment om het hier te bewaren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij serce przy dowolnej chwili, aby ją tu zachować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque no coração de qualquer momento para guardá-lo aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажми на сердечко у любого момента, чтобы он появился здесь."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på hjärtat på ett ögonblick för att spara det här."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Burada saklamak için herhangi bir anın kalbine dokun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Торкнись сердечка на будь-якому моменті, щоб зберегти його тут."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点任意瞬间上的心形，即可把它收藏在这里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點一下任一瞬間的愛心，就能把它留在這裡。"
          }
        }
      }
    },
    "Tap the moments you want in the movie. It needs at least 5." : {
      "comment" : "New movie (F05): intro when choosing moments by hand",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك لمس اللحظات التي تريدها في الفيلم. يلزمه 5 لحظات على الأقل."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Націсні на моманты, якія хочаш бачыць у фільме. Патрэбна прынамсі 5."
          }
        },
        "de" : {
          "stringUnit" : {
