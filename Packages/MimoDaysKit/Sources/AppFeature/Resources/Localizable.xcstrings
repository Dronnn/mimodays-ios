    "Find your memories by date or place. Turn a month, a year, or any part of your life into a movie made from real, little moments." : {
      "comment" : "OB-05 body",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك العثور على ذكرياتك حسب التاريخ أو المكان، وتحويل شهر أو سنة أو أي جزء من حياتك إلى فيلم من لحظات صغيرة حقيقية."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шукай успаміны па даце або месцы. Ператвары месяц, год ці любую частку свайго жыцця ў фільм з сапраўдных маленькіх момантаў."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finde deine Erinnerungen nach Datum oder Ort. Mach aus einem Monat, einem Jahr oder jedem Abschnitt deines Lebens einen Film aus echten, kleinen Momenten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Find your memories by date or place. Turn a month, a year, or any part of your life into a movie made from real, little moments."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encuentra tus recuerdos por fecha o lugar. Convierte un mes, un año o cualquier parte de tu vida en una película hecha de pequeños momentos reales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retrouve tes souvenirs par date ou par lieu. Transforme un mois, une année ou n’importe quel moment de ta vie en un film fait de vrais petits moments."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "למצוא זיכרונות לפי תאריך או מקום. להפוך חודש, שנה או כל חלק מהחיים לסרט שעשוי מרגעים קטנים ואמיתיים."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Գտիր հիշողություններդ ըստ ամսաթվի կամ վայրի։ Մեկ ամիսը, մեկ տարին կամ կյանքիդ ցանկացած մասը վերածիր ֆիլմի՝ իրական, փոքրիկ պահերից։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ritrova i tuoi ricordi per data o luogo. Trasforma un mese, un anno o qualsiasi parte della tua vita in un film fatto di piccoli momenti veri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日付や場所で思い出を探せます。ひと月、一年、人生のどんな一場面でも、ありのままの小さなモーメントを集めてムービーにできます。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "იპოვე მოგონებები თარიღით ან ადგილით. აქციე თვე, წელი ან ცხოვრების ნებისმიერი ნაწილი ნამდვილი, პატარა მომენტებისგან აწყობილ ფილმად."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Естеліктеріңді күні немесе орны бойынша тап. Бір айды, бір жылды не өміріңнің кез келген бөлігін нағыз кішкентай сәттерден құралған фильмге айналдыр."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "날짜나 장소로 추억을 찾아보세요. 한 달, 한 해, 또는 삶의 어느 한 부분을 진짜 작은 순간들로 이뤄진 무비로 만들어 보세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vind je herinneringen op datum of plek. Maak van een maand, een jaar of elk stukje van je leven een film van echte, kleine momenten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znajduj wspomnienia po dacie lub miejscu. Zamień miesiąc, rok albo dowolny kawałek swojego życia w film z prawdziwych, małych chwil."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encontre suas memórias por data ou lugar. Transforme um mês, um ano ou qualquer parte da sua vida em um filme feito de pequenos momentos reais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Находи воспоминания по дате или месту. Преврати месяц, год или любой отрезок жизни в фильм из настоящих маленьких моментов."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hitta dina minnen efter datum eller plats. Gör en månad, ett år eller vilken del av ditt liv som helst till en film av riktiga, små ögonblick."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anılarını tarihe veya yere göre bul. Bir ayı, bir yılı veya hayatının herhangi bir bölümünü gerçek, küçük anlardan oluşan bir filme dönüştür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Знаходь спогади за датою чи місцем. Перетвори місяць, рік чи будь-яку частину життя на фільм зі справжніх маленьких моментів."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按日期或地点找回回忆。把一个月、一年，或生活中的任何一段，变成一部由真实小瞬间组成的影片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依日期或地點尋找回憶。將一個月、一年，或生命中的任一段時光，用真實的小瞬間做成短片。"
          }
        }
      }
    },
