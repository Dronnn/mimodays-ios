    "%@ move to Recently deleted. You can bring them back within 30 days." : {
      "comment" : "Delete sheet (M15) body for one moment with more than its photo or video. %@ is its parts as a list, e.g. \"The photo, selfie window and voice note\"",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم نقل %@ إلى «المحذوفة مؤخرًا». يمكنك استعادتها خلال 30 يومًا."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ перамяшчаюцца ў «Нядаўна выдаленыя». Іх можна вярнуць на працягу 30 дзён."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kommen in „Zuletzt gelöscht“. Du kannst sie innerhalb von 30 Tagen zurückholen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ move to Recently deleted. You can bring them back within 30 days."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pasan a Eliminado recientemente. Puedes recuperarlos en un plazo de 30 días."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vont dans Suppressions récentes. Tu peux les récupérer pendant 30 jours."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ יועברו ל״נמחקו לאחרונה״. אפשר לשחזר אותם תוך 30 יום."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ տեղափոխվում են «Վերջերս ջնջված» բաժին։ Կարող ես դրանք վերականգնել 30 օրվա ընթացքում։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vanno in Eliminati di recente. Puoi recuperarli entro 30 giorni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は「最近削除した項目」に移動します。30日以内なら元に戻せます。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ გადავა „ახლახან წაშლილში“. 30 დღის განმავლობაში მათი დაბრუნება შეგიძლია."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ «Жақында жойылғандар» бөліміне өтеді. Оларды 30 күн ішінде қайтара аласың."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 모두 최근 삭제된 항목으로 이동해요. 30일 이내에 복구할 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ gaan naar Recent verwijderd. Je kunt ze binnen 30 dagen terugzetten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ trafią do Ostatnio usuniętych. Możesz je przywrócić w ciągu 30 dni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vão para Apagados. Você pode recuperá-los em até 30 dias."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ перемещаются в «Недавно удаленные». Их можно вернуть в течение 30 дней."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ flyttas till Nyligen raderade. Du kan återställa dem inom 30 dagar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Son Silinenler bölümüne taşınacak. 30 gün içinde geri getirebilirsin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ буде переміщено в «Нещодавно видалені». Їх можна повернути протягом 30 днів."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@将移到“最近删除”。30 天内可以恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@將移至「最近刪除」。30 天內都可以復原。"
          }
        }
      }
    },
