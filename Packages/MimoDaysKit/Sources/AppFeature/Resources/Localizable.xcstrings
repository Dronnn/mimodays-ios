    "Days and times follow wherever this iPhone is now, so a photo taken late in the evening can move to the next day." : {
      "comment" : "Memories settings (S09): note explaining Days follow this iPhone's time zone. On iPad it says iPad.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "variations" : {
            "device" : {
              "ipad" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "تتبع الأيام والأوقات الموقع الحالي لهذا الـ iPad، لذا قد تنتقل صورة التُقطت في وقت متأخر من المساء إلى اليوم التالي."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "تتبع الأيام والأوقات الموقع الحالي لهذا الـ iPhone، لذا قد تنتقل صورة التُقطت في وقت متأخر من المساء إلى اليوم التالي."
                }
              }
            }
          }
        },
        "be" : {
          "variations" : {
            "device" : {
              "ipad" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Дні і час залежаць ад таго, дзе гэты iPad зараз, таму фота, зробленае позна ўвечары, можа перайсці на наступны дзень."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Дні і час залежаць ад таго, дзе гэты iPhone зараз, таму фота, зробленае позна ўвечары, можа перайсці на наступны дзень."
                }
              }
            }
          }
        },
        "de" : {
          "variations" : {
            "device" : {
              "ipad" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Tage und Uhrzeiten richten sich danach, wo dieses iPad gerade ist – ein Foto vom späten Abend kann so auf den nächsten Tag rutschen."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Tage und Uhrzeiten richten sich danach, wo dieses iPhone gerade ist – ein Foto vom späten Abend kann so auf den nächsten Tag rutschen."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "device" : {
              "ipad" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Days and times follow wherever this iPad is now, so a photo taken late in the evening can move to the next day."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Days and times follow wherever this iPhone is now, so a photo taken late in the evening can move to the next day."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "device" : {
              "ipad" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Los días y las horas se ajustan a dónde esté ahora este iPad, así que una foto tomada tarde por la noche puede pasar al día siguiente."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Los días y las horas se ajustan a dónde esté ahora este iPhone, así que una foto tomada tarde por la noche puede pasar al día siguiente."
                }
              }
            }
          }
        },
        "fr" : {
          "variations" : {
            "device" : {
              "ipad" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Les jours et les heures suivent l’endroit où se trouve cet iPad maintenant : une photo prise tard le soir peut donc passer au lendemain."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Les jours et les heures suivent l’endroit où se trouve cet iPhone maintenant : une photo prise tard le soir peut donc passer au lendemain."
                }
              }
            }
          }
        },
        "he" : {
          "variations" : {
            "device" : {
              "ipad" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "הימים והשעות נקבעים לפי המיקום הנוכחי של ה־iPad הזה, כך שתמונה שצולמה מאוחר בערב יכולה לעבור ליום הבא."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "הימים והשעות נקבעים לפי המיקום הנוכחי של ה־iPhone הזה, כך שתמונה שצולמה מאוחר בערב יכולה לעבור ליום הבא."
                }
              }
            }
          }
        },
        "hy" : {
          "variations" : {
            "device" : {
              "ipad" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Օրերն ու ժամերը հետևում են այն վայրին, որտեղ հիմա է այս iPad-ը, ուստի ուշ երեկոյան արված լուսանկարը կարող է տեղափոխվել հաջորդ օր։"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Օրերն ու ժամերը հետևում են այն վայրին, որտեղ հիմա է այս iPhone-ը, ուստի ուշ երեկոյան արված լուսանկարը կարող է տեղափոխվել հաջորդ օր։"
                }
              }
            }
          }
        },
        "it" : {
          "variations" : {
            "device" : {
              "ipad" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Giorni e orari seguono il luogo in cui si trova ora questo iPad, quindi una foto scattata a tarda sera può passare al giorno dopo."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Giorni e orari seguono il luogo in cui si trova ora questo iPhone, quindi una foto scattata a tarda sera può passare al giorno dopo."
                }
              }
            }
          }
        },
        "ja" : {
          "variations" : {
            "device" : {
              "ipad" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "日時は、このiPadの現在地に合わせて表示されます。そのため、夜遅くに撮った写真が翌日に移ることがあります。"
                }
              },
              "other" : {
