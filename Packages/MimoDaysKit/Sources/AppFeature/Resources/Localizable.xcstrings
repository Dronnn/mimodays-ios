    "The recording stopped at %@ when you left MimoDays. The part before is kept." : {
      "comment" : "Review after a recording stopped early (C13d). %@ = where it stopped, e.g. 0:06; the app went to the background",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توقف التسجيل عند %@ عندما غادرت MimoDays. تم الاحتفاظ بالجزء السابق."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запіс спыніўся на %@ пры выхадзе з MimoDays. Частка да гэтага захавана."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Aufnahme wurde bei %@ gestoppt, als du MimoDays verlassen hast. Der Teil davor bleibt erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The recording stopped at %@ when you left MimoDays. The part before is kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La grabación se detuvo en %@ al salir de MimoDays. Se conserva la parte anterior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’enregistrement s’est arrêté à %@ quand tu as quitté MimoDays. La partie d’avant est conservée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ההקלטה נעצרה ב־%@ ביציאה מ־MimoDays. החלק שלפני העצירה נשמר."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Տեսագրությունը կանգ առավ %@-ին, երբ դուրս եկար MimoDays-ից։ Մինչ այդ նկարածդ մասը պահպանված է։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La registrazione si è interrotta a %@ quando hai lasciato MimoDays. La parte precedente è stata conservata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MimoDaysを離れたため、%@で録画が止まりました。それまでの部分は残っています。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MimoDays-იდან გასვლისას ჩაწერა %@-ზე შეწყდა. მანამდე ჩაწერილი ნაწილი შენახულია."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MimoDays қолданбасынан шыққанда, жазу %@ белгісінде тоқтады. Оған дейінгі бөлігі сақталды."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MimoDays를 나가면서 %@ 지점에서 녹화가 멈췄어요. 그전까지 녹화된 부분은 남아 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De opname stopte bij %@ toen je MimoDays verliet. Het deel daarvoor blijft bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po wyjściu z MimoDays nagrywanie zatrzymało się w %@. Wcześniejsza część została zachowana."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gravação parou em %@ quando você saiu do MimoDays. A parte anterior foi mantida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запись остановилась на %@ при выходе из MimoDays. Все, что было до этого, сохранено."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspelningen stoppades vid %@ när du lämnade MimoDays. Delen före sparas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MimoDays uygulamasından çıktığında kayıt %@ noktasında durdu. Önceki kısım saklandı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запис зупинився на %@ після виходу з MimoDays. Частину до цього збережено."
