    "Tbilisi · optional": {
      "comment": "Sample place chip in onboarding art",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tbilisi · optional"
          }
        }
      }
    },
    "The camera is turned off for MimoDays": {
      "comment": "C13a title: camera access was denied in Settings",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera is turned off for MimoDays"
          }
        }
      }
    },
    "The camera turns on only while this screen is open, and only you start a recording. Nothing is captured in the background or sent anywhere.": {
      "comment": "C06 body: camera explainer",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera turns on only while this screen is open, and only you start a recording. Nothing is captured in the background or sent anywhere."
          }
        }
      }
    },
    "The microphone records only while you are recording a video or a voice note. You can say no: videos are still saved, just silent.": {
      "comment": "C06c body: microphone explainer",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone records only while you are recording a video or a voice note. You can say no: videos are still saved, just silent."
          }
        }
      }
    },
    "To capture moments, allow camera access in Settings. You can still write notes and record voice notes from Today.": {
      "comment": "C13a body: camera access off",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To capture moments, allow camera access in Settings. You can still write notes and record voice notes from Today."
          }
        }
      }
    },
    "Today": {
      "comment": "Tab: today's capture screen",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today"
          }
        }
      }
    },
    "We take photos of birthdays and big adventures. But most of life happens on ordinary days. MimoDays helps you remember those, too.": {
      "comment": "OB-01 body",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We take photos of birthdays and big adventures. But most of life happens on ordinary days. MimoDays helps you remember those, too."
          }
        }
      }
    },
    "Winter": {
      "comment": "Season label under a sample movie clip",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Winter"
          }
        }
      }
    },
    "You and the world around you.": {
      "comment": "OB-03 title",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You and the world around you."
          }
        }
      }
    },
    "Your captures stay on your device by default. You choose when to back up, share, export, or delete them. No public profile is required.": {
      "comment": "OB-06 body",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your captures stay on your device by default. You choose when to back up, share, export, or delete them. No public profile is required."
          }
        }
      }
    },
    "Your life, in little pieces.": {
      "comment": "OB-01 title",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
