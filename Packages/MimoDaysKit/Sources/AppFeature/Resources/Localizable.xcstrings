    "The map can't be shown right now. Your places are all here." : {
      "comment" : "Map (P06) when the map can't load; the places are listed under it. Two lines, as drawn.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتعذّر عرض الخريطة الآن.\nكل أماكنك موجودة هنا."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карту зараз немагчыма паказаць.\nУсе твае месцы тут."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Karte kann gerade nicht angezeigt werden.\nDeine Orte sind alle hier."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The map can't be shown right now.\nYour places are all here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora no se puede mostrar el mapa.\nTodos tus lugares están aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carte ne peut pas s’afficher pour le moment.\nTous tes lieux sont ici."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן להציג את המפה כרגע.\nכל המקומות שלך נמצאים כאן."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Քարտեզը հիմա չի ցուցադրվում։\nՔո բոլոր վայրերն այստեղ են։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al momento la mappa non si può mostrare.\nI tuoi luoghi sono tutti qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在、地図を表示できません。\n保存した場所はすべてここにあります。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "რუკა ახლა ვერ გამოჩნდება.\nშენი ყველა ადგილი აქ არის."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Картаны қазір көрсету мүмкін емес.\nБарлық орындарың осында."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금은 지도를 표시할 수 없어요.\n장소는 모두 여기에 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De kaart kan nu niet worden getoond.\nAl je plekken staan hier."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można teraz wyświetlić mapy.\nWszystkie twoje miejsca są tutaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível mostrar o mapa agora.\nTodos os seus lugares estão aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карту сейчас не показать.\nВсе твои места здесь."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kartan kan inte visas just nu.\nAlla dina platser finns här."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harita şu anda gösterilemiyor.\nTüm yerlerin burada."
