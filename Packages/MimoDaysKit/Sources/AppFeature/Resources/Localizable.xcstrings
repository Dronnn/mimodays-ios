        "hy" : {
          "variations" : {
            "device" : {
              "ipad" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "MimoDays-ը ստուգում է, թե որտեղ է այս iPad-ը, միայն երբ դիտում ես նկարածդ կամ օգտագործում ես քարտեզը, երբեք՝ ֆոնային ռեժիմում։ Քաղաքի անունը որոշելու համար այն դիմում է Apple-ի քարտեզների ծառայությանը։ Կարող ես անջատել վայրերը կամ հեռացնել բոլորը։"
                }
