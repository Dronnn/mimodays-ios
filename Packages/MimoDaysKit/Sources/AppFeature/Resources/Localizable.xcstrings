        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Խոսափողը ձայնագրում է միայն, երբ ձայնային գրառում ես անում։ Ձայնային գրառումները մնում են քո սարքում։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il microfono registra solo mentre registri una nota vocale. Le note vocali restano sul tuo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マイクで録音するのは、音声メモを録音しているときだけです。音声メモはデバイス内に保存されます。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "მიკროფონი მხოლოდ ხმოვანი ჩანაწერის ჩაწერისას იწერს. ხმოვანი ჩანაწერები შენს მოწყობილობაზე რჩება."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Микрофон тек дауыстық жазба жазып алғанда дыбыс жазады. Дауыстық жазбалар құрылғыңда қалады."
