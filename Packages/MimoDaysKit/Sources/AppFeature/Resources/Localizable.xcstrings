        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сәттерді таңдап, оларға орынды қолмен қос. Ештеңе автоматты түрде ізделмейді."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "순간을 선택하고 직접 장소를 지정하세요. 자동으로 조회하지 않아요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies momenten en geef ze zelf een plek. Er wordt niets automatisch opgezocht."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
