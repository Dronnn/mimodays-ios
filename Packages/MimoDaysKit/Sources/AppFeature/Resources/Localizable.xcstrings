    "Say a few words, write a note, or save the moment without a caption. Time is recorded automatically. Location is optional." : {
      "comment" : "OB-04 body",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك قول بضع كلمات أو كتابة ملاحظة أو حفظ اللحظة بلا تعليق. يُسجّل الوقت تلقائيًا. والموقع اختياري."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скажы некалькі слоў, напішы нататку або захавай момант без подпісу. Час запісваецца аўтаматычна. Месца дадаецца па жаданні."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprich ein paar Worte, schreib eine Notiz oder speichere den Moment ohne Bildunterschrift. Die Uhrzeit wird automatisch erfasst. Der Ort ist optional."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Say a few words, write a note, or save the moment without a caption. Time is recorded automatically. Location is optional."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di unas palabras, escribe una nota o guarda el momento sin leyenda. La hora se registra automáticamente. La ubicación es opcional."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dis quelques mots, écris une note ou enregistre le moment sans légende. L’heure est enregistrée automatiquement. Le lieu est facultatif."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר לומר כמה מילים, לכתוב הערה או לשמור את הרגע בלי כיתוב. הזמן מתועד אוטומטית. המיקום הוא לבחירתך."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Մի քանի բառ ասա, գրառում արա կամ պահպանիր պահն առանց մակագրության։ Ժամն ինքնաբերաբար է գրանցվում։ Վայրը՝ ըստ ցանկության։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di' qualche parola, scrivi una nota o salva il momento senza didascalia. L'ora viene registrata automaticamente. La posizione è facoltativa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ひとこと話したり、メモを書いたり、キャプションなしで保存したりできます。時刻は自動で記録されます。場所の保存は任意です。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "თქვი რამდენიმე სიტყვა, დაწერე ჩანიშვნა ან შეინახე მომენტი წარწერის გარეშე. დრო ავტომატურად იწერება. მდებარეობა არასავალდებულოა."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бірнеше сөз айт, жазба жаз немесе сәтті жазусыз сақта. Уақыт автоматты түрде жазылады. Орын қосу міндетті емес."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "몇 마디를 말하거나 메모를 쓰거나, 캡션 없이 순간을 저장하세요. 시간은 자동으로 기록돼요. 위치는 선택 사항이에요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeg een paar woorden, schrijf een notitie of bewaar het moment zonder bijschrift. De tijd wordt automatisch vastgelegd. Locatie is optioneel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powiedz kilka słów, napisz notatkę albo zapisz chwilę bez podpisu. Czas zapisuje się automatycznie. Lokalizacja jest opcjonalna."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diga algumas palavras, escreva uma nota ou salve o momento sem legenda. O horário é registrado automaticamente. A localização é opcional."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скажи пару слов, напиши заметку или сохрани момент без подписи. Время записывается автоматически. Место – по желанию."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säg några ord, skriv en anteckning eller spara ögonblicket utan bildtext. Tiden sparas automatiskt. Plats är valfritt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birkaç kelime söyle, not yaz veya anı açıklamasız kaydet. Saat otomatik kaydedilir. Konum isteğe bağlıdır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скажи кілька слів, напиши нотатку або збережи момент без підпису. Час записується автоматично. Місце — за бажанням."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "说几句话、写个备注，或者不加说明直接存储瞬间。时间会自动记录，地点可选。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "說幾句話、寫下筆記，或不加說明文字，直接儲存瞬間。時間會自動記錄，地點則可自由選擇。"
          }
        }
      }
    },
    "Say a few words?" : {
      "comment" : "Explainer title before the system microphone prompt, from Voice note",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
