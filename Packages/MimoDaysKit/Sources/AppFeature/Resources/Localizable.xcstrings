    "The fade-in time follows the lead (%@)." : {
      "comment" : "U53: footnote, the picture fades in over 0.6 of the lead. %@: seconds, e.g. 1.2 s",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
