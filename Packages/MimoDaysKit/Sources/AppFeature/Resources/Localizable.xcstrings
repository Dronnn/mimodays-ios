    "An archive keeps everything together with a list of dates, notes and places that any computer can read." : {
      "comment" : "Export (E02): what 'One archive (.zip)' makes",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجمع الأرشيف كل شيء مع قائمة بالتواريخ والملاحظات والأماكن يمكن لأي كمبيوتر قراءتها."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Архіў захоўвае ўсё разам са спісам дат, нататак і месцаў, які можна прачытаць на любым камп'ютары."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Archiv hält alles zusammen, mit einer Liste von Daten, Notizen und Orten, die jeder Computer lesen kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An archive keeps everything together with a list of dates, notes and places that any computer can read."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un archivo comprimido lo guarda todo junto, con una lista de fechas, notas y lugares que cualquier equipo puede leer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une archive réunit tout, avec une liste des dates, notes et lieux lisible par n’importe quel ordinateur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ארכיון שומר הכול יחד עם רשימת תאריכים, הערות ומקומות שכל מחשב יכול לקרוא."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Արխիվը պահում է ամեն ինչ միասին՝ ամսաթվերի, գրառումների և վայրերի ցանկով, որը կարդացվում է ցանկացած համակարգչով։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un archivio tiene tutto insieme, con un elenco di date, note e luoghi leggibile da qualsiasi computer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アーカイブには、日付、メモ、場所の一覧とともに、すべてがまとめられます。一覧はどのコンピュータでも読めます。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "არქივი ყველაფერს ერთად ინახავს, თარიღების, ჩანიშვნებისა და ადგილების სიით, რომელსაც ნებისმიერი კომპიუტერი წაიკითხავს."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Архив бәрін бір жерде сақтайды және кез келген компьютер оқи алатын күндер, жазбалар мен орындар тізімін қосады."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "압축 파일에 모든 항목과 날짜, 메모, 장소 목록이 함께 담겨요. 이 목록은 어떤 컴퓨터에서든 읽을 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een archief houdt alles bij elkaar, met een lijst van datums, notities en plekken die elke computer kan lezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archiwum trzyma wszystko razem, z listą dat, notatek i miejsc, którą odczyta każdy komputer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um arquivo compactado mantém tudo junto, com uma lista de datas, notas e lugares que qualquer computador consegue ler."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Архив хранит все вместе со списком дат, заметок и мест, который откроет любой компьютер."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett arkiv håller ihop allt med en lista över datum, anteckningar och platser som alla datorer kan läsa."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arşiv, her şeyi bir arada tutar. Her bilgisayarda okunabilen bir tarih, not ve yer listesi de içerir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Архів тримає все разом зі списком дат, нотаток і місць, який прочитає будь-який комп’ютер."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "归档文件会把所有内容放在一起，并附上一份任何电脑都能读取的日期、备注和地点列表。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "封存檔會將所有內容放在一起，並附上任何電腦都能讀取的日期、筆記和地點清單。"
          }
        }
      }
    },
