    "Each moment as its own files, named by the date and time it was taken." : {
      "comment" : "Export (E02): what 'Separate files' makes",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لكل لحظة ملفاتها الخاصة، بأسماء تحمل تاريخ التقاطها ووقته."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кожны момант асобнымі файламі з назвамі па даце і часе здымкі."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Moment als eigene Dateien, benannt nach Datum und Uhrzeit der Aufnahme."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each moment as its own files, named by the date and time it was taken."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada momento en sus propios archivos, con el nombre de la fecha y la hora en que se tomó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque moment dans ses propres fichiers, nommés d’après la date et l’heure de la prise."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כל רגע בקבצים משלו, עם שמות לפי התאריך והשעה שבהם צולם."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Յուրաքանչյուր պահ՝ առանձին ֆայլերով, որոնք անվանված են նկարելու ամսաթվով և ժամով։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni momento in file separati, con il nome dato da data e ora dello scatto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モーメントごとに個別のファイルになり、撮影日時がファイル名になります。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "თითოეული მომენტი ცალკე ფაილებად, გადაღების თარიღითა და დროით დასახელებული."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Әр сәт түсірілген күні мен уақыты бойынша аталған жеке файлдар түрінде."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 순간을 촬영 날짜와 시간을 이름으로 하는 개별 파일로 만들어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elk moment als eigen bestanden, met als naam de datum en tijd waarop het is gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każda chwila jako osobne pliki, nazwane datą i godziną ujęcia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada momento em seus próprios arquivos, com o nome da data e da hora em que foi feito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый момент – отдельными файлами, названными по дате и времени съемки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje ögonblick som egna filer, namngivna efter datum och tid då det togs."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her an, çekildiği tarih ve saatle adlandırılan ayrı dosyalar olarak."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кожен момент — окремими файлами з назвою за датою й часом зйомки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个瞬间存为单独的文件，以拍摄日期和时间命名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個瞬間各自匯出為檔案，並以拍攝日期和時間命名。"
          }
        }
      }
    },
    "Each one finds its place here, month by month. Tap any piece to open it." : {
      "comment" : "Mosaic note body while there are fewer than ten moments (U14).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل لحظة تجد مكانها هنا، شهرًا بعد شهر. يمكنك فتح أي قطعة بلمسها."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кожны знаходзіць тут сваё месца, месяц за месяцам. Націсні на любы кавалачак, каб адкрыць яго."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder findet hier seinen Platz, Monat für Monat. Tippe auf ein Steinchen, um es zu öffnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each one finds its place here, month by month. Tap any piece to open it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada uno encuentra aquí su sitio, mes a mes. Toca cualquier pieza para abrirla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chacun trouve sa place ici, mois après mois. Touche un morceau pour l’ouvrir."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כל רגע מוצא כאן את מקומו, חודש אחר חודש. להקיש על כל פיסה כדי לפתוח אותה."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ամեն մեկն այստեղ իր տեղն է գտնում՝ ամիս առ ամիս։ Հպիր ցանկացած կտորի՝ այն բացելու համար։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ognuno trova il suo posto qui, mese dopo mese. Tocca un tassello per aprirlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一つひとつが、月ごとにここに並びます。ピースをタップすると開きます。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "თითოეული აქ თავის ადგილს პოულობს, თვიდან თვემდე. შეეხე ნებისმიერ ნაწილს, რომ გახსნა."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Әрқайсысы мұнда ай-айымен өз орнын табады. Ашу үшін кез келген бөлікті түрт."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "순간마다 이곳에 자리를 잡고, 한 달씩 모여 가요. 조각을 탭하면 열 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elk moment krijgt hier een plekje, maand na maand. Tik op een stukje om het te openen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każda znajdzie tu swoje miejsce, miesiąc po miesiącu. Stuknij dowolny kawałek, aby go otworzyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada um encontra seu lugar aqui, mês a mês. Toque em qualquer peça para abrir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый находит здесь свое место, месяц за месяцем. Нажми на любой кусочек, чтобы открыть его."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vart och ett hittar sin plats här, månad för månad. Tryck på en bit för att öppna den."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her biri ay ay burada yerini bulur. Açmak için herhangi bir parçaya dokun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кожен знаходить тут своє місце, місяць за місяцем. Торкнись будь-якого шматочка, щоб відкрити його."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个瞬间都会按月份在这里找到自己的位置。轻点任意一块即可打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個瞬間都在這裡找到自己的位置，逐月累積。點一下任一拼塊就能打開。"
          }
        }
      }
    },
    "Each one goes to the day it was taken and is marked \"Imported\". They have no selfie window. The originals stay in Photos." : {
      "comment" : "Import from Photos (E05): what happens to the picked files",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يوضع كل عنصر في يوم التقاطه ويحمل علامة «مستوردة». لا تحتوي هذه العناصر على نافذة السيلفي. تبقى النسخ الأصلية في «الصور»."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кожны файл трапляе ў дзень, калі ён быў зняты, і атрымлівае пазнаку «Імпартавана». У гэтых момантаў няма акенца сэлфі. Арыгіналы застаюцца ў «Фота»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Aufnahme wird dem Tag zugeordnet, an dem sie gemacht wurde, und mit „Importiert“ markiert. Die Aufnahmen haben kein Selfie-Fenster. Die Originale bleiben in „Fotos“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each one goes to the day it was taken and is marked \"Imported\". They have no selfie window. The originals stay in Photos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada elemento se coloca en el día en que se capturó y se marca como «Importado». No tienen ventana de selfie. Los originales permanecen en Fotos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque élément est placé au jour où il a été pris et porte la mention « Importé ». Ces éléments n’ont pas de fenêtre selfie. Les originaux restent dans Photos."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כל פריט משויך ליום שבו צולם ומסומן בתווית “יובא”. לפריטים האלה אין חלון סלפי. המקוריים נשארים ב״תמונות״."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Յուրաքանչյուր ֆայլ ավելացվում է իր նկարահանման օրվան և նշվում որպես «Ներմուծված»։ Դրանք սելֆի պատուհան չունեն։ Բնօրինակները մնում են «Լուսանկարներ»-ում։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni elemento viene inserito nel giorno in cui è stato ripreso e contrassegnato come «Importato». Questi elementi non hanno un riquadro selfie. Gli originali restano in Foto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "それぞれ撮影した日に追加され、「読み込み済み」と表示されます。自撮りウインドウは付きません。元のファイルは「写真」に残ります。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "თითოეული ფაილი გადაღების დღეს ემატება და იღებს ნიშნულს „იმპორტირებული“. მათ სელფის ფანჯარა არ აქვთ. ორიგინალები „ფოტოებში“ რჩება."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Әр файл түсірілген күніне қосылып, «Импортталған» деп белгіленеді. Оларда селфи терезесі болмайды. Түпнұсқалар «Фотолар» қолданбасында қалады."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 항목은 촬영한 날짜에 추가되고 “가져옴”으로 표시돼요. 셀피 창은 없어요. 원본은 사진 앱에 그대로 남아요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elk item komt op de dag waarop het is vastgelegd en krijgt het label ‘Geïmporteerd’. Deze items hebben geen selfievenster. De originelen blijven in Foto’s."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy element trafia do dnia, w którym został zarejestrowany, i otrzymuje oznaczenie „Zaimportowano”. Te elementy nie mają okienka selfie. Oryginały zostają w Zdjęciach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada item vai para o dia em que foi capturado e recebe a marca “Importado”. Esses itens não têm janela de selfie. Os originais ficam no Fotos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый файл попадает в день, когда он был снят, и получает отметку «Импортирован». У этих моментов нет окна селфи. Оригиналы остаются в «Фото»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje objekt hamnar på dagen då det togs och märks med ”Importerad”. De har inget selfiefönster. Originalen stannar i Bilder."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her öğe çekildiği güne eklenir ve “İçe aktarıldı” olarak işaretlenir. Bu öğelerde selfie penceresi yoktur. Orijinaller Fotoğraflar’da kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кожен файл потрапляє в день, коли його було знято, й отримує позначку «Імпортовано». У цих моментів немає віконця селфі. Оригінали залишаються у «Фото»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个项目都会归到拍摄当天，并标记为「已导入」。这些瞬间没有自拍小窗。原始文件会留在「照片」中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個項目都會歸入拍攝當天，並標示為「已匯入」。這些瞬間沒有自拍小視窗。原始檔會留在「照片」中。"
          }
        }
      }
    },
