    "Nothing is lost. Try again in a moment." : {
      "comment" : "Alert message when saving a moment failed for a reason other than space; the capture stays on review",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
