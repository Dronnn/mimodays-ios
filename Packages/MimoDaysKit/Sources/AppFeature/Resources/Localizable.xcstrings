    "Keep MimoDays open. If you leave, the backup pauses and continues when you come back." : {
      "comment" : "Backup in progress (E04p): note",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرجى إبقاء MimoDays مفتوحًا. إذا غادرت التطبيق، يتوقف النسخ الاحتياطي مؤقتًا ويُستأنف عند عودتك."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не закрывай MimoDays. Калі выйсці, капіраванне прыпыніцца і працягнецца, калі ты вернешся."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass MimoDays geöffnet. Wenn du die App verlässt, pausiert das Backup und läuft weiter, sobald du zurückkommst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep MimoDays open. If you leave, the backup pauses and continues when you come back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén MimoDays abierta. Si sales, la copia se pausa y continúa cuando vuelvas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garde MimoDays ouvert. Si tu le quittes, la sauvegarde se met en pause et reprend à ton retour."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "להשאיר את MimoDays פתוחה. ביציאה ממנה הגיבוי מושהה, וממשיך בחזרה אליה."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Մի՛ փակիր MimoDays-ը։ Եթե դուրս գաս, պահուստավորումը կդադարի և կշարունակվի, երբ վերադառնաս։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni aperto MimoDays. Se esci, il backup va in pausa e riprende quando torni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MimoDaysを開いたままにしてください。別の画面に移るとバックアップは一時停止し、戻ると再開します。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MimoDays ღია დატოვე. თუ გახვალ, სარეზერვო ასლის შექმნა შეჩერდება და დაბრუნებისას გაგრძელდება."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MimoDays қолданбасын ашық ұста. Шығып кетсең, сақтық көшірме кідіреді де, қайтып келгенде жалғасады."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MimoDays를 열어 두세요. 앱을 나가면 백업이 일시 정지되고, 돌아오면 계속돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd MimoDays open. Als je weggaat, pauzeert de reservekopie en gaat hij verder als je terugkomt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie zamykaj MimoDays. Jeśli wyjdziesz, tworzenie kopii zostanie wstrzymane i wznowi się, gdy wrócisz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha o MimoDays aberto. Se você sair, o backup pausa e continua quando você voltar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не закрывай MimoDays. Если уйти, копирование приостановится и продолжится, когда ты вернешься."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll MimoDays öppen. Om du lämnar appen pausas säkerhetskopieringen och fortsätter när du kommer tillbaka."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MimoDays açık kalsın. Uygulamadan çıkarsan yedekleme duraklar, döndüğünde devam eder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не закривай MimoDays. Якщо вийдеш, створення копії призупиниться й продовжиться, коли повернешся."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请保持 MimoDays 处于打开状态。如果离开，备份会暂停，回来后继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請保持 MimoDays 開啟。離開後備份會暫停，回來時繼續。"
          }
        }
      }
    },
