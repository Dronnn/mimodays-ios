    "Location, if you allow it: to save where a moment happened and to show where you are on the map." : {
      "comment" : "Help & about (S07): Permissions help",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الموقع، إذا سمحت به: لحفظ مكان حدوث اللحظة، ولإظهار مكانك على الخريطة."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Месцазнаходжанне, калі дазволіш: каб захоўваць, дзе адбыўся момант, і паказваць на карце, дзе ты."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standort, wenn du ihn erlaubst: um zu speichern, wo ein Moment passiert ist, und um auf der Karte zu zeigen, wo du bist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location, if you allow it: to save where a moment happened and to show where you are on the map."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubicación, si la permites: para guardar dónde ocurrió un momento y mostrar dónde estás en el mapa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Localisation, si tu l’autorises : pour enregistrer où un moment s’est passé et afficher ta position sur la carte."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מיקום, אם ניתנת הרשאה: לשמירת המקום שבו קרה רגע ולהצגת המיקום הנוכחי במפה."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Տեղորոշում, եթե թույլ տաս՝ պահպանելու, թե որտեղ է պահը տեղի ունեցել, և քարտեզին ցույց տալու, թե որտեղ ես։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posizione, se la consenti: per salvare dove è successo un momento e per mostrare dove ti trovi sulla mappa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置情報：許可した場合、モーメントを撮った場所の保存と、地図上での現在地の表示に使用します。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "მდებარეობა, თუ ნებას დართავ: რომ შეინახოს, სად მოხდა მომენტი, და რუკაზე გაჩვენოს, სად ხარ."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Геолокация — егер рұқсат етсең: сәттің қай жерде болғанын сақтау және картада қайда екеніңді көрсету үшін."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위치(허용한 경우): 순간이 일어난 장소를 저장하고 지도에 현재 위치를 보여 주는 데 사용해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locatie, als je het toestaat: om te bewaren waar een moment gebeurde en om op de kaart te tonen waar je bent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokalizacja, jeśli na nią pozwolisz: aby zapisać, gdzie wydarzyła się chwila, i pokazać na mapie, gdzie jesteś."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Localização, se você permitir: para salvar onde um momento aconteceu e mostrar onde você está no mapa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Геопозиция, если разрешишь: чтобы сохранять, где случился момент, и показывать на карте, где ты."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plats, om du tillåter det: för att spara var ett ögonblick hände och visa var du är på kartan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İzin verirsen konum: anın yaşandığı yeri kaydetmek ve haritada nerede olduğunu göstermek için."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Геолокація, якщо дозволиш: щоб зберігати, де стався момент, і показувати на мапі, де ти."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置（如果你允许）：用于保存瞬间发生的地点，并在地图上显示你的位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置：允許後，可儲存瞬間發生的地點，並在地圖上顯示目前所在位置。"
          }
        }
      }
    },
