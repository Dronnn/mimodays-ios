          "stringUnit" : {
            "state" : "translated",
            "value" : "Сюрпрызы прыходзяць толькі ў гэты час. Рэжымы фокусавання ўсё роўна дзейнічаюць."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überraschungen kommen nur zwischen diesen Uhrzeiten. Fokus-Modi gelten weiterhin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Surprises only arrive between these times. Focus modes still apply."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las sorpresas solo llegan entre estas horas. Los modos de concentración se siguen aplicando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les surprises n’arrivent qu’entre ces heures. Les modes Concentration s’appliquent toujours."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הפתעות מגיעות רק בין השעות האלה. מצבי ריכוז עדיין חלים."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Անակնկալները գալիս են միայն այս ժամերի միջև։ Կենտրոնացման ռեժիմները շարունակում են գործել։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sorprese arrivano solo in questa fascia oraria. Le modalità Full immersion restano valide."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サプライズはこの時間帯にだけ届きます。集中モードの設定も適用されます。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "სიურპრიზები მხოლოდ ამ საათებს შორის მოდის. ფოკუსის რეჟიმებიც კვლავ მოქმედებს."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тосын сыйлар тек осы уақыт аралығында келеді. Фокустау режимдері де ескеріледі."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서프라이즈는 이 시간 안에만 와요. 집중 모드도 계속 적용돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verrassingen komen alleen tussen deze tijden. Focusmodi blijven gelden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niespodzianki przychodzą tylko w tych godzinach. Tryby skupienia nadal działają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As surpresas só chegam entre esses horários. Os modos de Foco continuam valendo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сюрпризы приходят только в эти часы. Режимы фокусирования продолжают действовать."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Överraskningar kommer bara mellan de här tiderna. Fokuslägen gäller fortfarande."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sürprizler yalnızca bu saatler arasında gelir. Odak modları yine geçerlidir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сюрпризи приходять лише в цей час. Режими фокусування й далі діють."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "惊喜只会在这些时间之间到来。专注模式仍然有效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "驚喜只會在這段時間內到來，並仍會遵循「專注模式」設定。"
          }
        }
      }
    },
