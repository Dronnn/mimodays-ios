            "value" : "Twee keer per dag, tussen %1$@ en %2$@. Je kunt dit altijd wijzigen in Instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dwa razy dziennie, między %1$@ a %2$@. Możesz to zmienić, kiedy zechcesz, w Ustawieniach."
          }
        },
        "pt-BR" : {
