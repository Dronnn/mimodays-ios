            "state" : "translated",
            "value" : "Бұлардың кез келгенін жеке фильм немесе экспорт үшін өзгерте аласың."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "개별 무비나 내보내기에서는 이 설정을 모두 따로 바꿀 수 있어요."
