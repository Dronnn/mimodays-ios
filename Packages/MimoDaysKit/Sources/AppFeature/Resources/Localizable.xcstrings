{
  "sourceLanguage": "en",
  "strings": {
    "%@ of %@": {
      "comment": "Voice note sheet (C09): accessibility value of the stop button, e.g. \"12 seconds of 1 minute\". First: time recorded, second: the limit",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ of %2$@"
          }
        }
      }
    },
    "%@ · Surprise": {
      "comment": "Origin of a moment, after its time in lists and review: \"8:05 AM · Surprise\". The moment answered a surprise notification",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · Surprise"
          }
        }
      }
    },
    "%lld moments": {
      "comment": "On this day (T06): how many moments that day has.",
