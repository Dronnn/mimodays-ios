            "value" : "Tap the heart on any moment to keep it here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca el corazón de cualquier momento para guardarlo aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touche le cœur d’un moment pour le garder ici."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "להקיש על הלב בכל רגע כדי לשמור אותו כאן."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ցանկացած պահի սրտիկին հպիր՝ այն այստեղ պահելու համար։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
