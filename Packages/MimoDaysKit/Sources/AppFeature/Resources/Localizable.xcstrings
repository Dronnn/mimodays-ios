    "Whatever today looks like, it counts." : {
      "comment" : "Surprise notification body (one of two, picked at random)",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كيفما كان يومك، فهو يستحق."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якім бы ні быў сённяшні дзень, ён важны."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie auch immer heute aussieht – es zählt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whatever today looks like, it counts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sea como sea el día de hoy, cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelle que soit la tête d’aujourd’hui, il compte."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "איך שלא נראה היום, הוא נחשב."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ինչպիսին էլ լինի այսօրդ, այն կարևոր է։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comunque sia andata oggi, conta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どんな今日にも、残す価値があります。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "როგორიც უნდა იყოს დღევანდელი დღე, ის მნიშვნელოვანია."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бүгінгі күнің қандай болса да, ол маңызды."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘이 어떤 모습이든, 소중한 순간이에요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoe vandaag er ook uitziet, het telt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieważne, jaki jest dzisiejszy dzień. Też się liczy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seja como for o dia de hoje, ele conta."
          }
        },
