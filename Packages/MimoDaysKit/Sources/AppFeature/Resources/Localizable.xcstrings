    "A call stopped the recording at %@. The part before the call is kept." : {
      "comment" : "Review after a recording stopped early (C13d). %@ = where it stopped, e.g. 0:06; a call or another app took the camera",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أوقفت مكالمةٌ التسجيل عند %@. تم الاحتفاظ بالجزء الذي سبق المكالمة."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Званок спыніў запіс на %@. Частка да званка захавана."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Anruf hat die Aufnahme bei %@ gestoppt. Der Teil vor dem Anruf bleibt erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A call stopped the recording at %@. The part before the call is kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una llamada detuvo la grabación en %@. Se conserva la parte anterior a la llamada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un appel a interrompu l’enregistrement à %@. La partie avant l’appel est conservée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שיחה עצרה את ההקלטה ב־%@. החלק שלפני השיחה נשמר."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Զանգն ընդհատեց տեսագրությունը %@-ին։ Զանգից առաջվա մասը պահպանված է։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una chiamata ha interrotto la registrazione a %@. La parte prima della chiamata è stata conservata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "着信により%@で録画が止まりました。着信前の部分は残っています。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ზარმა ჩაწერა %@-ზე შეაჩერა. ზარამდე ჩაწერილი ნაწილი შენახულია."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Қоңырау жазуды %@ белгісінде тоқтатты. Қоңырауға дейінгі бөлігі сақталды."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "통화 때문에 %@ 지점에서 녹화가 멈췄어요. 통화 전까지 녹화된 부분은 남아 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een oproep stopte de opname bij %@. Het deel van vóór de oproep blijft bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Połączenie przerwało nagrywanie w %@. Część sprzed połączenia zostaje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma ligação interrompeu a gravação em %@. A parte antes da ligação foi mantida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Звонок остановил запись на %@. Все, что было до звонка, сохранено."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett samtal avbröt inspelningen vid %@. Delen före samtalet sparas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir arama nedeniyle kayıt %@ noktasında durdu. Aramadan önceki kısım saklandı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дзвінок зупинив запис на %@. Частину до дзвінка збережено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "来电在 %@ 处中断了录制。来电前的部分已保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "來電讓錄影在 %@ 停止。來電前錄下的部分已保留。"
          }
        }
      }
    },
