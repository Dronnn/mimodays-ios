        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst sie alle in den iOS-Einstellungen ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can change any of them in iOS Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes cambiar cualquiera de ellos en Ajustes de iOS."
          }
