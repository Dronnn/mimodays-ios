    "MimoDays only adds what you save. It can't see the rest of your library." : {
      "comment" : "Explainer message before the system Photos (add only) prompt",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضيف MimoDays ما تحفظه فقط. ولا يمكنه رؤية بقية مكتبتك."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MimoDays толькі дадае тое, што ты захоўваеш. Астатняй медыятэкі MimoDays не бачыць."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MimoDays fügt nur hinzu, was du speicherst. Den Rest deiner Mediathek sieht die App nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MimoDays only adds what you save. It can't see the rest of your library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MimoDays solo añade lo que guardas. No puede ver el resto de tu fototeca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MimoDays ajoute seulement ce que tu enregistres. L’app ne voit pas le reste de ta photothèque."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MimoDays מוסיפה רק את מה שנשמר לפי בחירתך. אין לה גישה לשאר הספרייה."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MimoDays-ն ավելացնում է միայն այն, ինչ պահպանում ես։ Քո լուսադարանի մնացած մասը այն չի տեսնում։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MimoDays aggiunge solo ciò che salvi. Non può vedere il resto della tua libreria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MimoDaysは保存を選んだものだけを追加します。ライブラリのほかの写真やビデオを見ることはできません。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MimoDays მხოლოდ იმას ამატებს, რასაც ინახავ. შენი ბიბლიოთეკის დანარჩენ ნაწილს ვერ ხედავს."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MimoDays тек сен сақтағанды қосады. Ол медиатекаңның қалған бөлігін көре алмайды."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MimoDays는 저장하는 항목만 추가해요. 보관함의 나머지 항목은 볼 수 없어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MimoDays voegt alleen toe wat je bewaart. De rest van je bibliotheek kan de app niet zien."
          }
