    "Recently deleted always asks for %@ when App Lock is on." : {
      "comment" : "Privacy settings (S05): note under App Lock. %@: Face ID, Touch ID, Optic ID or 'your passcode'",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تطلب «المحذوفة مؤخرًا» دائمًا %@ عند تشغيل قفل التطبيق."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Калі ўключана блакіроўка праграмы, «Нядаўна выдаленыя» заўсёды запытваюць %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Zuletzt gelöscht“ fragt immer nach %@, wenn die App-Sperre an ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recently deleted always asks for %@ when App Lock is on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminado recientemente siempre pide %@ cuando el bloqueo de la app está activado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suppressions récentes demande toujours %@ quand le Verrouillage de l’app est activé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "״נמחקו לאחרונה״ תמיד דורש %@ כשנעילת האפליקציה מופעלת."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Երբ հավելվածի կողպումը միացված է, «Վերջերս ջնջված» բաժինը միշտ պահանջում է %@։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminati di recente richiede sempre %@ quando il Blocco app è attivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリロックがオンのときは、「最近削除した項目」を開くたびに%@が必要です。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "როცა აპის ჩაკეტვა ჩართულია, „ახლახან წაშლილი“ ყოველთვის ითხოვს: %@."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Қолданба құлпы қосулы болса, «Жақында жойылғандар» бөлімі әрдайым %@ арқылы растауды сұрайды."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 잠금이 켜져 있으면 최근 삭제된 항목을 열 때 항상 %@ 인증이 필요해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recent verwijderd vraagt altijd om %@ als App-vergrendeling aan staat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy Blokada aplikacji jest włączona, Ostatnio usunięte zawsze wymagają potwierdzenia (%@)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apagados sempre pede %@ quando o Bloqueio do app está ativado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Недавно удаленные» всегда запрашивают %@, когда включена блокировка приложения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyligen raderade kräver alltid %@ när Applås är på."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama Kilidi açıkken Son Silinenler her zaman %@ ile doğrulama ister."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Нещодавно видалені» завжди запитують %@, коли ввімкнено блокування застосунку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启应用锁后，打开“最近删除”时总是需要%@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟「App 鎖定」時，進入「最近刪除」一律需要%@。"
          }
        }
      }
    },
    "Record again" : {
      "comment" : "Review after a recording stopped early (C13d): text button that drops the clip and goes back to the camera",
      "extractionState" : "manual",
