        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Олардың кез келгенін iOS параметрлерінде өзгерте аласың."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 설정에서 언제든 바꿀 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt ze allemaal wijzigen in de iOS-instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każde z tych uprawnień możesz zmienić w Ustawieniach iOS."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode mudar qualquer uma delas nos Ajustes do iOS."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Любое из них можно изменить в Настройках iOS."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan ändra dem när som helst i iOS-inställningar."
          }
        },
