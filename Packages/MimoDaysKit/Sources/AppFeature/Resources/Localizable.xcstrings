    "Today headline" : {
      "comment" : "Today's headline (T02). Keep the line break where it reads naturally in two short lines; on iPad it shows on one line.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حياتك،\nبتفاصيل صغيرة."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тваё жыццё,\nпа кавалачку."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Leben,\nin kleinen Stücken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your life,\nin little pieces."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu vida,\nen pedacitos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta vie,\npar petits bouts."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החיים שלך,\nבפיסות קטנות."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Քո կյանքը՝\nփոքրիկ պատառներով։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua vita,\na piccoli pezzi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日々のかけらが、\n人生になる。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "შენი ცხოვრება,\nპატარა ნაწილებად."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Өміріңнің\nшағын сәттері."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "작은 조각으로\n담아낸 일상."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je leven,\nin kleine stukjes."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje życie.\nMałe chwile."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua vida,\nem pedacinhos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твоя жизнь\nпо кусочкам."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditt liv,\ni små bitar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hayatın,\nküçük parçalar hâlinde."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твоє життя —\nмаленькими шматочками."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生活，\n一点一滴。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生活，\n盡在點滴。"
          }
        }
      }
