    "Try the camera. Save the photo or video only if you like it." : {
      "comment" : "First capture invitation (onboarding O09): body",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك تجربة الكاميرا وحفظ الصورة أو الفيديو إذا أعجبك فقط."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Паспрабуй камеру. Захавай фота ці відэа, толькі калі спадабаецца."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probier die Kamera aus. Speichere das Foto oder Video nur, wenn es dir gefällt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try the camera. Save the photo or video only if you like it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prueba la cámara. Guarda la foto o el video solo si te gusta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essaie la caméra. N’enregistre la photo ou la vidéo que si elle te plaît."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לנסות את המצלמה. לשמור את התמונה או הסרטון רק אם הם מוצאים חן."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Փորձիր տեսախցիկը։ Պահպանիր լուսանկարը կամ տեսանյութը միայն, եթե հավանես։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prova la fotocamera. Salva la foto o il video solo se ti piace."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラを試してみましょう。気に入った写真やビデオだけを保存できます。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "სცადე კამერა. ფოტო ან ვიდეო მხოლოდ მაშინ შეინახე, თუ მოგეწონება."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Камераны байқап көр. Фотоны немесе бейнені тек ұнаса ғана сақта."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카메라를 사용해 보세요. 사진이나 동영상이 마음에 들 때만 저장하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probeer de camera. Bewaar de foto of video alleen als je hem mooi vindt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wypróbuj aparat. Zapisz zdjęcie lub wideo tylko wtedy, gdy ci się spodoba."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Experimente a câmera. Salve a foto ou o vídeo só se você gostar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попробуй камеру. Сохрани фото или видео, только если понравится."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testa kameran. Spara bilden eller videon bara om du gillar den."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamerayı dene. Fotoğrafı veya videoyu yalnızca beğenirsen kaydet."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спробуй камеру. Зберігай фото чи відео, лише якщо вони тобі подобаються."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "试试相机吧。喜欢的话再存储照片或视频。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "試試相機。喜歡的照片或影片，再儲存就好。"
          }
        }
      }
    },
    "Turn a month, a trip or a whole year of moments into a short film." : {
      "comment" : "Movies empty state (F01e): what a movie is",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك تحويل لحظات شهر أو رحلة أو سنة كاملة إلى فيلم قصير."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ператвары месяц, паездку ці цэлы год момантаў у кароткі фільм."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mach aus einem Monat, einer Reise oder einem ganzen Jahr voller Momente einen kurzen Film."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn a month, a trip or a whole year of moments into a short film."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convierte un mes, un viaje o un año entero de momentos en un cortometraje."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transforme un mois, un voyage ou toute une année de moments en court métrage."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "להפוך חודש, טיול או שנה שלמה של רגעים לסרט קצר."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Մեկ ամսվա, ճամփորդության կամ ամբողջ տարվա պահերը վերածիր կարճ ֆիլմի։"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trasforma un mese, un viaggio o un anno intero di momenti in un breve film."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ひと月、旅、一年分のモーメントを、短い映画に。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "აქციე თვის, მოგზაურობის ან მთელი წლის მომენტები მოკლე ფილმად."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бір айдың, сапардың немесе тұтас жылдың сәттерін қысқа фильмге айналдыр."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 달, 여행, 또는 한 해의 순간을 짧은 무비로 만들어 보세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak van een maand, een reis of een heel jaar aan momenten een korte film."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamień chwile z miesiąca, podróży lub całego roku w krótki film."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
