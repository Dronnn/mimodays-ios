    "You and the world around you." : {
      "comment" : "OB-03 title",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنت والعالم من حولك."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты і свет вакол цябе."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du und die Welt um dich herum."
          }
