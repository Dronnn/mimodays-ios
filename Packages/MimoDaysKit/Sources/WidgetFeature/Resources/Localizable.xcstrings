    "One memory at a time; Another shows a different one." : {
      "comment" : "Widget gallery: Random memory's description; Another is the widget's button (P8.2).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One memory at a time; Another shows a different one."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Erinnerung nach der anderen; „Noch eine“ zeigt eine andere."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un souvenir à la fois ; « Un autre » en montre un différent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un recuerdo cada vez; «Otro» muestra uno distinto."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un ricordo alla volta; «Un altro» ne mostra uno diverso."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eén herinnering tegelijk; ‘Nog een’ toont een andere."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett minne i taget; ”Ett till” visar ett annat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedno wspomnienie naraz; „Inne” pokazuje kolejne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma memória por vez; “Outra” mostra uma diferente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По одному воспоминанию; «Другое» покажет новое."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По одному спогаду; «Інший» покаже новий."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Па адным успаміне; «Іншы» пакажа новы."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Մեկ հիշողություն միաժամանակ, «Ուրիշը»՝ մեկ այլ։"
