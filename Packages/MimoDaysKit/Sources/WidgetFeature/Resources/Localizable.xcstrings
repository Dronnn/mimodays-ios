          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бір уақытта бір естелік; «Басқасы» жаңасын көрсетеді."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
